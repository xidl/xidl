{% from "macros.j2" import render_type %}

{%- if doc and doc | length > 0 -%}
    {{ "/**\n * " ~ (doc | join("\n * ")) ~ "\n */\n" }}
{%- endif %}{{ "export interface " ~ name ~ " {\n" }}
{%- for param in params -%}
    {%- if param.doc and param.doc | length > 0 -%}
    {{ "    /**\n     * " ~ (param.doc | join("\n     * ")) ~ "\n     */\n" }}
    {%- endif %}    {{ param.prop }}{% if param.optional %}?{% endif %}: {{ render_type(param.ty) }};{{ "\n" }}
{%- endfor %}}
