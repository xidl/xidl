{% from "macros.j2" import render_zod %}{% if recursive %}
export const {{ schema_name }}Schema: z.ZodType<import("./{{ file_stem }}").{{ type_path }}> = z.lazy(() => z.object({
    {% for field in fields %}
        {{ field.prop }}: {{ render_zod(field.schema) }}{% if field.optional %}.optional(){% endif %}{% if not loop.last %},{% endif %}
    {% endfor %}
}));
{%- else %}
    export const {{ schema_name }}Schema = z.object({
        {% for field in fields %}
            {{ field.prop }}: {{ render_zod(field.schema) }}{% if field.optional %}.optional(){% endif %}{% if not loop.last %},{% endif %}
        {% endfor %}
    });
{%- endif %}
