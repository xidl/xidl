{% import "macros.j2" as m %}
// Code generated by xidlc-v{{ opt.xidlc_version }}-{{ opt.xidlc_shorthash }}. DO NOT EDIT.
import type * as types from "./{{ file_stem }}";
import type * as ifaceTypes from "./{{ file_stem }}.iface";
import { z } from "zod";
{% if has_errors %}
    import * as errors from "./{{ file_stem }}.errors";
{% endif %}

export interface UnsupportedProjection {
    version: string;
    direction: "upcast" | "downcast";
    typePath: string;
    wireName?: string;
    reason: string;
}
export type VersionedResult<T> = { ok: true; value: T } | { ok: false; error: UnsupportedProjection };
/** A refusal retains the exact business outcome; callers must not repeat side effects. */
export type ProjectionOutcome<T, Head> =
| { projected: true; value: T }
| { projected: false; head: Head; error: UnsupportedProjection };
export interface FrameworkError { kind: "Framework"; error: unknown }
export const IGNORED = "xidl.ignored";
export type Ignored = typeof IGNORED;
/** A downcast decision leaves a removed optional member absent only by saying so. */
export const OMIT = "xidl.omit";
export type Omitted = typeof OMIT;
const ok = <T>(value: T): VersionedResult<T> => ({ ok: true, value });

function mapSequence<S, T>(source: S[], convert: (value: S) => VersionedResult<T>): VersionedResult<T[]> {
    const values: T[] = [];
    for (const value of source) {
        const next = convert(value);
        if (!next.ok) return next;
        values.push(next.value);
    }
    return ok(values);
}
function mapRecord<S, T>(source: Record<string, S>, convert: (value: S) => VersionedResult<T>): VersionedResult<Record<string, T>> {
    const entries: Array<[string, T]> = [];
    for (const [key, value] of Object.entries(source)) {
        const next = convert(value);
        if (!next.ok) return next;
        entries.push([key, next.value]);
    }
    return ok(Object.fromEntries(entries));
}
function mapOptional<S, T>(source: S | undefined, convert: (value: S) => VersionedResult<T>): VersionedResult<T | undefined> {
    return source === undefined ? ok(undefined) : convert(source);
}

{% include "http/adapters_wire.ts.j2" %}

/** Hooks are required application decisions. Keep them pure and deterministic. */
export interface VersionAdapters {
    {% for hook in hooks %}
        {{ hook.name }}(source: {{ m.render_type(hook.input) }}{% if hook.stored %}, stored: Pick<StoredValues, {% for reader in hook.stored %}{{ reader | tojson }}{% if not loop.last %} | {% endif %}{% endfor %}>{% endif %}): VersionedResult<{{ m.render_type(hook.output) }}>;
    {% endfor %}
}
{% if readers %}
    /** Members older versions still read that Head no longer carries, resolved per Head instance by the application. */
    export interface StoredValues {
        {% for reader in readers %}
            /** wire `{{ reader.wire }}`, last served by {{ reader.version }} */
            {{ reader.name }}(source: {{ m.render_type(reader.input) }}): {{ m.render_type(reader.output) }};
        {% endfor %}
    }
    /** Wire names each served version still reads from storage, by type; Head reads nothing. */
    export const NEEDS = {
        {% for need in needs %}
            {{ need.key | tojson }}: { {% for entry in need.entries %}{{ entry[0] | tojson }}: [{% for wire in entry[1] %}{{ wire | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}]{% if not loop.last %}, {% endif %}{% endfor %} },
        {% endfor %}
    } as const;
{% endif %}
{% for decision in decisions %}
    export interface {{ decision.name }} {
        {% for field in decision.fields %}
            {{ field.key }}{% if field.optional %}?{% endif %}: {{ m.render_type(field.ty) }};
        {% endfor %}
    }
{% endfor %}

{% macro convert(value, source) -%}
    {%- if value.kind == "Identity" -%}ok({{ source }})
    {%- elif value.kind == "Named" -%}{{ value.data.name }}({{ source }}{% if value.data.stored %}, stored{% endif %}, adapters)
    {%- elif value.kind == "Sequence" -%}mapSequence({{ source }}, (item) => {{ convert(value.data, "item") }})
    {%- elif value.kind == "Map" -%}mapRecord({{ source }}, (item) => {{ convert(value.data, "item") }})
    {%- elif value.kind == "Optional" -%}mapOptional({{ source }}, (item) => {{ convert(value.data, "item") }})
{%- endif -%}
{%- endmacro %}

{% for c in conversions %}
    export function {{ c.name }}(source: {{ m.render_type(c.source) }}{% if c.stored %}, stored: StoredValues{% endif %}, adapters: VersionAdapters): VersionedResult<{{ m.render_type(c.target) }}> {
        {% if c.kind == "hook" %}
            return adapters.{{ c.hook }}(source);
        {% elif c.kind == "alias" %}
            return {{ convert(c.value, "source") }};
        {% elif c.kind == "enum" %}
            switch (source) {
                {% for shared in c.shared_values %}
                    case {{ shared | tojson }}: return ok(source);
                {% endfor %}
                {% if c.hook %}
                    default: return adapters.{{ c.hook }}(source);
                {% else %}
                    default: { const exhaustive: never = source; return ok(exhaustive); }
                {% endif %}
            }
        {% elif c.kind == "union" %}
            {% for copy in c.copies %}
                if ({{ copy.source | tojson }} in source) {
                    const projected = {{ convert(copy.value, "source[" ~ (copy.source | tojson) ~ "]") }};
                    if (!projected.ok) return projected;
                    return ok({ [{{ copy.target | tojson }}]: projected.value });
                }
            {% endfor %}
            {% if c.hook %}
                return adapters.{{ c.hook }}(source);
            {% else %}
                const exhaustive: never = source;
                return ok(exhaustive);
            {% endif %}
        {% else %}
            {% if c.hook %}
                const decision = adapters.{{ c.hook }}(source{% if c.hook_stored %}, stored{% endif %});
                if (!decision.ok) return decision;
            {% endif %}
            {% for copy in c.copies %}
                const converted{{ loop.index0 }} = {{ convert(copy.value, "source[" ~ (copy.source | tojson) ~ "]") }};
                if (!converted{{ loop.index0 }}.ok) return converted{{ loop.index0 }};
            {% endfor %}
            return ok({
                {% for copy in c.copies %}
                    {% if copy.optional %}
                        ...(converted{{ loop.index0 }}.value === undefined ? {} : { [{{ copy.target | tojson }}]: converted{{ loop.index0 }}.value }),
                    {% else %}
                        [{{ copy.target | tojson }}]: converted{{ loop.index0 }}.value,
                    {% endif %}
                {% endfor %}
                {% for field in c.assignments %}
                    {% if field.omittable %}
                        ...(decision.value[{{ field.source | tojson }}] === OMIT ? {} : { [{{ field.target | tojson }}]: decision.value[{{ field.source | tojson }}] }),
                    {% elif field.optional %}
                        ...(decision.value[{{ field.source | tojson }}] === undefined ? {} : { [{{ field.target | tojson }}]: decision.value[{{ field.source | tojson }}] }),
                    {% else %}
                        [{{ field.target | tojson }}]: decision.value[{{ field.source | tojson }}],
                    {% endif %}
                {% endfor %}
            });
        {% endif %}
    }
{% endfor %}

{% for op in operations %}
    function downcastStep{{ op.prefix }}ResultTo{{ op.from }}(value: {{ m.render_type(op.result_source) }}{% if op.stored %}, stored: StoredValues{% endif %}, adapters: VersionAdapters): VersionedResult<{{ m.render_type(op.result_target) }}> {
        const projected = {{ op.result_call.name }}({% if op.result_source_direct %}{ return: value }{% elif op.result_source.kind == "Void" %}{}{% else %}value{% endif %}{% if op.result_call.stored %}, stored{% endif %}, adapters);
        if (!projected.ok) return projected;
        return ok({% if op.result_target_direct %}projected.value.return{% elif op.result_target.kind == "Void" %}undefined{% else %}projected.value{% endif %});
    }
    export type {{ op.prefix }}ErrorFrom{{ op.from }} = {% for class in op.errors_source %}errors.{{ class }} | {% endfor %}FrameworkError;
    export type {{ op.prefix }}ErrorTo{{ op.from }} = {% for class in op.errors_target %}errors.{{ class }} | {% endfor %}FrameworkError;
    function downcastStep{{ op.prefix }}ErrorTo{{ op.from }}(head: {{ op.prefix }}ErrorFrom{{ op.from }}{% if op.stored %}, stored: StoredValues{% endif %}, adapters: VersionAdapters): VersionedResult<{{ op.prefix }}ErrorTo{{ op.from }}> {
        {% for arm in op.error_arms %}
            if (head instanceof errors.{{ arm.class }}) {
                {% if arm.hook %}
                    return adapters.{{ arm.hook }}(head);
                {% else %}
                    const projected = {{ arm.call.name }}(head{% if arm.call.stored %}, stored{% endif %}, adapters);
                    if (!projected.ok) return projected;
                    return ok(new errors.{{ arm.target_class }}(projected.value));
                {% endif %}
            }
        {% endfor %}
        return ok(head);
    }
{% endfor %}

