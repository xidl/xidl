{% import "macros.j2" as m %}
// Code generated by xidlc-v{{ opt.xidlc_version }}-{{ opt.xidlc_shorthash }}. DO NOT EDIT.
import type * as types from "./{{ file_stem }}";
import type * as ifaceTypes from "./{{ file_stem }}.iface";
import { z } from "zod";
{% if has_errors %}
    import * as errors from "./{{ file_stem }}.errors";
{% endif %}

export interface UnsupportedProjection {
    version: string;
    direction: "upcast" | "downcast";
    typePath: string;
    wireName?: string;
    reason: string;
}
export type VersionedResult<T> = { ok: true; value: T } | { ok: false; error: UnsupportedProjection };
{%- if has_updates %}
    /** An upcast value together with the members its handler persists. */
    export type UpcastValue<T, S> = { value: T; stored: S };
{% endif %}
/** A refusal retains the exact business outcome; callers must not repeat side effects. */
export type ProjectionOutcome<T, Head> =
| { projected: true; value: T }
| { projected: false; head: Head; error: UnsupportedProjection };
export interface FrameworkError { kind: "Framework"; error: unknown }
/** Merges stored bags with Rust `Option::or` semantics: the first defined
 * value for a key wins, and a later explicit `undefined` never overwrites. */
function mergeStored<T extends object>(...parts: (T | undefined)[]): T {
    const merged: Record<string, unknown> = {};
    for (const part of parts) {
        for (const [key, value] of Object.entries(part ?? {})) {
            if (value !== undefined && merged[key] === undefined) {
                merged[key] = value;
            }
        }
    }
    return merged as T;
}
export const IGNORED = "xidl.ignored";
export type Ignored = typeof IGNORED;
/** A downcast decision leaves a removed optional member absent only by saying so. */
export const OMIT = "xidl.omit";
export type Omitted = typeof OMIT;
const ok = <T>(value: T): VersionedResult<T> => ({ ok: true, value });

function locate<T>(result: VersionedResult<T>, path: string): VersionedResult<T> {
    if (result.ok) return result;
    return { ok: false, error: { ...result.error, typePath: `${path}.${result.error.typePath}` } };
}
function mapSequence<S, T>(source: S[], convert: (value: S) => VersionedResult<T>, path: string): VersionedResult<T[]> {
    const values: T[] = [];
    for (const value of source) {
        const next = locate(convert(value), path);
        if (!next.ok) return next;
        values.push(next.value);
    }
    return ok(values);
}
function mapRecord<S, T>(source: Record<string, S>, convert: (value: S) => VersionedResult<T>, path: string): VersionedResult<Record<string, T>> {
    const entries: Array<[string, T]> = [];
    for (const [key, value] of Object.entries(source)) {
        const next = locate(convert(value), path);
        if (!next.ok) return next;
        entries.push([key, next.value]);
    }
    return ok(Object.fromEntries(entries));
}
function mapOptional<S, T>(source: S | undefined, convert: (value: S) => VersionedResult<T>): VersionedResult<T | undefined> {
    return source === undefined ? ok(undefined) : convert(source);
}

