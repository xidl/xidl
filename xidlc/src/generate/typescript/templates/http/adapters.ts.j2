/** Required pure application decisions. Use strictFunctionTypes to reject narrower inputs. */
export interface VersionAdapters {
    {% for hook in hooks %}
        {{ hook.name }}: (source: {{ m.render_type(hook.input) }}{% if hook.current %}, current: {{ m.render_type(hook.current) }}{% endif %}{% if hook.stored %}, stored: Pick<StoredValues, {% for reader in hook.stored %}{{ reader | tojson }}{% if not loop.last %} | {% endif %}{% endfor %}>{% endif %}) => VersionedResult<{{ m.render_type(hook.output) }}>;
    {% endfor %}
}
{% if readers %}
    /** Members older versions still read that Head no longer carries, resolved by the application from the source instance of the downcast step that retires them. */
    export interface StoredValues {
        {% for reader in readers %}
            /** wire `{{ reader.wire }}`, last served by {{ reader.version }} */
            {{ reader.name }}(source: {{ m.render_type(reader.input) }}): {{ m.render_type(reader.output) }};
        {% endfor %}
    }
    /** Wire names each served version still reads from storage, by type; Head reads nothing. */
    export const NEEDS = {
        {% for need in needs %}
            {{ need.key | tojson }}: { {% for entry in need.entries %}{{ entry[0] | tojson }}: [{% for wire in entry[1] %}{{ wire | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}]{% if not loop.last %}, {% endif %}{% endfor %} },
        {% endfor %}
    } as const;
{% endif %}
{% for decision in decisions %}
    export interface {{ decision.name }} {
        {% for field in decision.fields %}
            {{ field.key }}{% if field.optional %}?{% endif %}: {{ m.render_type(field.ty) }};
        {% endfor %}
    }
{% endfor %}
{% for bag in update_stored %}
    /** Members the update handler persists for this request chain. */
    export interface {{ bag.name }} {
        {% for field in bag.fields %}
            {{ field.key }}?: {{ m.render_type(field.ty) }};
        {% endfor %}
    }
{% endfor %}

{% macro convert(value, source, path) -%}
    {%- if value.kind == "Identity" -%}ok({{ source }})
    {%- elif value.kind == "Named" -%}{{ value.data.name }}({{ source }}{% if value.data.current %}, current{% endif %}{% if value.data.stored %}, stored{% endif %}, adapters)
    {%- elif value.kind == "Sequence" -%}mapSequence({{ source }}, (item) => {{ convert(value.data, "item", path) }}, {{ path | tojson }})
    {%- elif value.kind == "Map" -%}mapRecord({{ source }}, (item) => {{ convert(value.data, "item", path) }}, {{ path | tojson }})
    {%- elif value.kind == "Optional" -%}mapOptional({{ source }}, (item) => {{ convert(value.data, "item", path) }})
{%- endif -%}
{%- endmacro %}

{% for c in conversions %}
    export function {{ c.name }}(source: {{ m.render_type(c.source) }}{% if c.current %}, current: {{ m.render_type(c.current_type) }}{% endif %}{% if c.stored %}, stored: StoredValues{% endif %}, adapters: VersionAdapters): {% if c.pair %}VersionedResult<UpcastValue<{{ m.render_type(c.target) }}, {{ c.stored_type }}>>{% else %}VersionedResult<{{ m.render_type(c.target) }}>{% endif %} {
        {% if c.kind == "hook" %}
            return adapters.{{ c.hook }}(source);
        {% elif c.kind == "alias" %}
            return {{ convert(c.value, "source", c.path) }};
        {% elif c.kind == "enum" %}
            switch (source) {
                {% for shared in c.shared_values %}
                    case {{ shared | tojson }}: return ok(source);
                {% endfor %}
                {% if c.hook %}
                    default: return adapters.{{ c.hook }}(source);
                {% else %}
                    default: { const exhaustive: never = source; return ok(exhaustive); }
                {% endif %}
            }
        {% elif c.kind == "union" %}
            {% for copy in c.copies %}
                if ({{ copy.source | tojson }} in source) {
                    const projected = {{ convert(copy.value, "source[" ~ (copy.source | tojson) ~ "]", c.path ~ "." ~ copy.source) }};
                    if (!projected.ok) return projected;
                    return ok({ [{{ copy.target | tojson }}]: projected.value });
                }
            {% endfor %}
            {% if c.hook %}
                return adapters.{{ c.hook }}(source);
            {% else %}
                const exhaustive: never = source;
                return ok(exhaustive);
            {% endif %}
        {% else %}
            {% if c.hook %}
                const decision = adapters.{{ c.hook }}(source{% if c.hook_current %}, current{% endif %}{% if c.hook_stored %}, stored{% endif %});
                if (!decision.ok) return decision;
            {% endif %}
            {% for copy in c.copies %}
                const converted{{ loop.index0 }} = {{ convert(copy.value, "source[" ~ (copy.source | tojson) ~ "]", c.path ~ "." ~ copy.source) }};
                if (!converted{{ loop.index0 }}.ok) return converted{{ loop.index0 }};
            {% endfor %}
            {%- if c.pair %}
                return ok({
                    value: {
                        {% for copy in c.copies %}
                            {% set unwrapped = ".value.value" if copy.value.kind == "Named" and copy.value.data.pair else ".value" %}
                            {% if copy.optional %}
                                ...(converted{{ loop.index0 }}{{ unwrapped }} === undefined ? {} : { [{{ copy.target | tojson }}]: converted{{ loop.index0 }}{{ unwrapped }} }),
                            {% else %}
                                [{{ copy.target | tojson }}]: converted{{ loop.index0 }}{{ unwrapped }},
                            {% endif %}
                        {% endfor %}
                        {% for field in c.assignments %}
                            {% if field.omittable %}
                                ...(decision.value[{{ field.source | tojson }}] === OMIT ? {} : { [{{ field.target | tojson }}]: decision.value[{{ field.source | tojson }}] }),
                            {% elif field.optional %}
                                ...(decision.value[{{ field.source | tojson }}] === undefined ? {} : { [{{ field.target | tojson }}]: decision.value[{{ field.source | tojson }}] }),
                            {% else %}
                                [{{ field.target | tojson }}]: decision.value[{{ field.source | tojson }}],
                            {% endif %}
                        {% endfor %}
                    },
                    stored: mergeStored(
                        {% for copy in c.copies %}
                            {% if copy.value.kind == "Named" and copy.value.data.pair %}
                                converted{{ loop.index0 }}.value.stored,
                            {% endif %}
                        {% endfor %}
                        {% if c.stored_field %}
                            decision.value.stored,
                        {% endif %}
                    ),
                });
            {%- else %}
            return ok({
                {% for copy in c.copies %}
                    {%- if copy.optional %}
                        ...(converted{{ loop.index0 }}.value === undefined ? {} : { [{{ copy.target | tojson }}]: converted{{ loop.index0 }}.value }),
                    {%- else %}
                        [{{ copy.target | tojson }}]: converted{{ loop.index0 }}.value,
                    {%- endif %}
                {%- endfor %}
                {% for field in c.assignments %}
                    {%- if field.omittable %}
                        ...(decision.value[{{ field.source | tojson }}] === OMIT ? {} : { [{{ field.target | tojson }}]: decision.value[{{ field.source | tojson }}] }),
                    {%- elif field.optional %}
                        ...(decision.value[{{ field.source | tojson }}] === undefined ? {} : { [{{ field.target | tojson }}]: decision.value[{{ field.source | tojson }}] }),
                    {%- else %}
                        [{{ field.target | tojson }}]: decision.value[{{ field.source | tojson }}],
                    {%- endif %}
                {%- endfor %}
            });
            {%- endif %}
        {% endif %}
    }
{% endfor %}

{% for op in operations %}
    function downcastStep{{ op.prefix }}ResultTo{{ op.from }}(value: {{ m.render_type(op.result_source) }}{% if op.stored %}, stored: StoredValues{% endif %}, adapters: VersionAdapters): VersionedResult<{{ m.render_type(op.result_target) }}> {
        const projected = {{ op.result_call.name }}({% if op.result_source_direct %}{ return: value }{% elif op.result_source.kind == "Void" %}{}{% else %}value{% endif %}{% if op.result_call.stored %}, stored{% endif %}, adapters);
        if (!projected.ok) return projected;
        return ok({% if op.result_target_direct %}projected.value.return{% elif op.result_target.kind == "Void" %}undefined{% else %}projected.value{% endif %});
    }
    export type {{ op.prefix }}ErrorFrom{{ op.from }} = {% for class in op.errors_source %}errors.{{ class }} | {% endfor %}FrameworkError;
    export type {{ op.prefix }}ErrorTo{{ op.from }} = {% for class in op.errors_target %}errors.{{ class }} | {% endfor %}FrameworkError;
    function downcastStep{{ op.prefix }}ErrorTo{{ op.from }}(head: {{ op.prefix }}ErrorFrom{{ op.from }}{% if op.stored %}, stored: StoredValues{% endif %}, adapters: VersionAdapters): VersionedResult<{{ op.prefix }}ErrorTo{{ op.from }}> {
        {% for arm in op.error_arms %}
            if (head instanceof errors.{{ arm.class }}) {
                {% if arm.hook %}
                    return adapters.{{ arm.hook }}(head);
                {% else %}
                    const projected = {{ arm.call.name }}(head{% if arm.call.stored %}, stored{% endif %}, adapters);
                    if (!projected.ok) return projected;
                    return ok(new errors.{{ arm.target_class }}(projected.value));
                {% endif %}
            }
        {% endfor %}
        return ok(head);
    }
{% endfor %}

