{% from "macros.j2" import render_type, render_zod %}
export interface {{ service_name }} {
    {% for method in methods %}
        {{ method.name }}({% for param in method.params %}{{ param.name }}: {{ render_type(param.ty) }}{% if not loop.last %}, {% endif %}{% endfor %}): Awaitable<{% if method.is_server_stream %}AsyncIterable<{{ render_type(method.stream_item_ty) }}>{% else %}{{ render_type(method.response_ty) }}{% endif %}>;
    {% endfor %}
}

export const {{ service_name }}Operations = {
    {% for method in methods %}
        {{ method.name }}: defineOperation<{{ service_name }}, "{{ method.name }}">({
            handler: "{{ method.name }}",
            method: "{{ method.http_method }}",
            path: "{{ method.path }}",
            paths: [{% for path in method.paths %}"{{ path }}"{% if not loop.last %}, {% endif %}{% endfor %}],
            request: {
                kind: "{% if method.is_client_stream %}stream{% elif method.params | length > 0 %}object{% else %}none{% endif %}",
                args: [{% for param in method.params %}"{{ param.key_name }}"{% if not loop.last %}, {% endif %}{% endfor %}],
                {% if method.request_schema_ref %}schema: ifaceSchemas.{{ method.request_schema_ref }}Schema,
                {% endif %}path: [{% for param in method.path_params %}{ parameter: "{{ param.template_name }}", wireName: "{{ param.template_name }}", key: "{{ param.key_name }}", multi: false, catchAll: {{ param.catch_all | lower }} }{% if not loop.last %}, {% endif %}{% endfor %}],
                query: [{% for param in method.query_params %}{ wireName: "{{ param.raw_name }}", key: "{{ param.key_name }}", multi: {{ param.is_multi | lower }} }{% if not loop.last %}, {% endif %}{% endfor %}],
                headers: [{% for param in method.header_params %}{ wireName: "{{ param.raw_name }}", key: "{{ param.key_name }}", multi: {{ param.is_multi | lower }} }{% if not loop.last %}, {% endif %}{% endfor %}],
                cookies: [{% for param in method.cookie_params %}{ wireName: "{{ param.raw_name }}", key: "{{ param.key_name }}", multi: {{ param.is_multi | lower }} }{% if not loop.last %}, {% endif %}{% endfor %}],
                body: {
                    kind: "{% if method.is_client_stream %}stream{% elif method.body_entries | length > 0 %}value{% else %}none{% endif %}",
                    contentType: "{{ method.request_content_type }}",
                    fields: [{% for entry in method.body_entries %}{ wireName: "{{ entry.raw_name }}", key: "{{ entry.key_name }}" }{% if not loop.last %}, {% endif %}{% endfor %}],
                    {% if method.body_single_key %}singleKey: "{{ method.body_single_key }}",
                    {% endif %}{% if method.body_schema_ref %}schema: ifaceSchemas.{{ method.body_schema_ref }}Schema,
                {% endif %}
            },
        },
        response: {
            status: {{ method.response_status }},
            contentType: "{{ method.response_content_type }}",
            bodyMode: "{{ method.response_body_mode }}",
            bodyFields: [{% for entry in method.response_body_entries %}{ wireName: "{{ entry.raw_name }}", key: "{{ entry.key_name }}" }{% if not loop.last %}, {% endif %}{% endfor %}],
            headers: [{% for param in method.response_header_params %}{ wireName: "{{ param.raw_name }}", key: "{{ param.key_name }}", multi: {{ param.is_multi | lower }} }{% if not loop.last %}, {% endif %}{% endfor %}],
            cookies: [{% for param in method.response_cookie_params %}{ wireName: "{{ param.raw_name }}", key: "{{ param.key_name }}", multi: {{ param.is_multi | lower }} }{% if not loop.last %}, {% endif %}{% endfor %}],
            {% if method.representations | length > 0 %}representations: [{% for repr in method.representations %}{ kind: "{{ repr.kind }}", contentType: "{{ repr.content_type }}"{% if not repr.is_byte %}, schema: {{ render_zod(repr.schema) }}{% endif %} }{% if not loop.last %}, {% endif %}{% endfor %}],
            {% endif %}{% if method.response_schema_ref and method.representations | length == 0 %}schema: ifaceSchemas.{{ method.response_schema_ref }}Schema,
            {% endif %}stream: {{ method.is_server_stream | lower }},
            {% if method.stream_item_schema_ref %}streamSchema: ifaceSchemas.{{ method.stream_item_schema_ref }}Schema,
            {% endif %}
        },
        security: [{% for security in method.security %}{ kind: "{{ security.kind }}"{% if security.location %}, location: "{{ security.location }}"{% endif %}{% if security.name %}, name: "{{ security.name }}"{% endif %}{% if security.realm %}, realm: "{{ security.realm }}"{% endif %} }{% if not loop.last %}, {% endif %}{% endfor %}],
        {% if method.raises | length > 0 %}
            errors: {
                match: (error: unknown) => {
                    {% for ex in method.raises %}
                        if (error instanceof {{ ex.ident }}) {
                            const headers = new Headers();
                            writeResponseBindings(headers, { ...error }, [{% for member in ex.headers %}{ wireName: "{{ member.wire_name }}", key: "{{ member.field }}", multi: {{ member.is_multi | lower }} }{% if not loop.last %}, {% endif %}{% endfor %}], false);
                            writeResponseBindings(headers, { ...error }, [{% for member in ex.cookies %}{ wireName: "{{ member.wire_name }}", key: "{{ member.field }}", multi: {{ member.is_multi | lower }} }{% if not loop.last %}, {% endif %}{% endfor %}], true);
                            {% if ex.has_body %}headers.set("Content-Type", "application/json");
                            return {
                                status: {{ ex.status }},
                                headers,
                                body: { {% for field in ex.body %}"{{ field.wire_name }}": error.{{ field.field }}, {% endfor %}},
                            };
                            {% else %}return { status: {{ ex.status }}, headers };
                        {% endif %}
                    }
                {% endfor %}
                return undefined;
            },
        },
        {% endif %}
    }),
    {% endfor %}
} as const;
