    #[allow(clippy::match_single_binding, non_snake_case, unused_variables)]
    async fn handle(&self, method: &str, params: ::serde_json::Value) -> Result<::serde_json::Value, xidl_jsonrpc::Error> {
        match method {
            {% for method in methods %}
                {% if method.kind == "rpc" %}
                    "{{ method.rpc_name }}" => {
                        let params: {{ method.params_struct }} = ::serde_json::from_value(
                            if params.is_null() { ::serde_json::json!({}) } else { params }
                        )
                        .map_err(|err| xidl_jsonrpc::Error::invalid_params(err.to_string()))?;
                        {% if method.args | length > 0 %}
                            let result = self.inner.{{ method.name }}({% for arg in method.args %}params.{{ arg }}{% if not loop.last %}, {% endif %}{% endfor %}).await?;
                        {% else %}
                            let result = self.inner.{{ method.name }}().await?;
                        {% endif %}
                        {{ encode_rpc_response(method) }}
                    }
                {% elif method.kind == "stream_op" and method.stream_mode == "client" %}
                    "{{ method.rpc_name }}" => {
                        let items: Vec<::serde_json::Value> = ::serde_json::from_value(params)
                            .map_err(|err| xidl_jsonrpc::Error::invalid_params(err.to_string()))?;
                        let stream = xidl_jsonrpc::stream::boxed(async_stream::try_stream! {
                            for item in items {
                                yield item;
                            }
                        });
                        let result = self.inner.{{ method.name }}(stream).await?;
                        {{ encode_rpc_response(method) }}
                    }
                {% endif %}
            {% endfor %}
            _ => Err(xidl_jsonrpc::Error::method_not_found(method)),
        }
    }

    #[allow(clippy::match_single_binding, unused_variables)]
    async fn validate_bidi(
        &self,
        method: &str,
        params: &::serde_json::Value,
    ) -> Result<(), xidl_jsonrpc::Error> {
        let _ = params;
        match method {
            {% for method in methods %}
                {% if method.kind == "stream_op" and method.stream_mode == "server" %}
                    "{{ method.rpc_name }}" => {
                        let _: {{ method.params_struct }} = ::serde_json::from_value(
                            if params.is_null() { ::serde_json::json!({}) } else { params.clone() }
                        )
                        .map_err(|err| xidl_jsonrpc::Error::invalid_params(err.to_string()))?;
                        Ok(())
                    }
                {% endif %}
            {% endfor %}
            _ => Ok(()),
        }
    }

    fn accepts_bidi(&self, _method: &str) -> bool {
        {% if bidi_method_names and bidi_method_names | length > 0 %}
            matches!(
                _method,
                {% for rpc_name in bidi_method_names %}
                    "{{ rpc_name }}"{% if not loop.last %} |{% endif %}
                {% endfor %}
