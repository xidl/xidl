        {% endif %}
    }

    #[allow(clippy::match_single_binding, unused_variables, unused_mut)]
    async fn handle_bidi(
        &self,
        method: &str,
        params: ::serde_json::Value,
        mut stream: xidl_jsonrpc::stream::ReaderWriter<::serde_json::Value, ::serde_json::Value>,
    ) -> Result<(), xidl_jsonrpc::Error> {
        match method {
            {% for method in methods %}
                {% if method.kind == "stream_op" and method.stream_mode == "server" %}
                    "{{ method.rpc_name }}" => {
                        let params: {{ method.params_struct }} = ::serde_json::from_value(
                            if params.is_null() { ::serde_json::json!({}) } else { params }
                        )
                        .map_err(|err| xidl_jsonrpc::Error::invalid_params(err.to_string()))?;
                        let mut out = self.inner.{{ method.name }}({% for arg in method.args %}params.{{ arg }}{% if not loop.last %}, {% endif %}{% endfor %}).await?;
                        while let Some(item) = xidl_jsonrpc::futures_util::StreamExt::next(&mut out).await {
                            stream.write(item?).await?;
                        }
                        stream.close().await?;
                        Ok(())
                    }
                {% elif method.kind == "stream_op" and method.stream_mode == "client" %}
                    "{{ method.rpc_name }}" => {
                        let (mut outbound, mut inbound_reader) = stream.into_parts();
                        let inbound = xidl_jsonrpc::stream::boxed(async_stream::try_stream! {
                            while let Some(item) = inbound_reader.read().await {
                                yield item?;
                            }
                        });
                        let result = self.inner.{{ method.name }}(inbound).await?;
                        {% if method.response_kind == "empty" %}
                            let wire = ::serde_json::Value::Null;
                        {% elif method.response_kind == "single_return" or method.response_kind == "single_output" %}
                            let wire = ::serde_json::to_value({{ method.response_struct }} { {{ method.response_single_field }}: result })?;
                        {% else %}
                            let wire = ::serde_json::to_value(result)?;
                        {% endif %}
                        outbound.write(wire).await?;
                        outbound.close().await?;
                        Ok(())
                    }
                {% elif method.kind == "stream_source" %}
                    "{{ method.rpc_name }}" => {
                        let mut out = self.inner.{{ method.name }}().await?;
                        while let Some(item) = xidl_jsonrpc::futures_util::StreamExt::next(&mut out).await {
                            let value = ::serde_json::to_value(item?)?;
                            stream.write(value).await?;
                        }
                        stream.close().await?;
                        Ok(())
                    }
                {% elif method.kind == "stream_op" and method.stream_mode == "bidi" %}
                    "{{ method.rpc_name }}" => self.inner.{{ method.name }}(stream).await,
                {% endif %}
            {% endfor %}
            _ => Err(xidl_jsonrpc::Error::method_not_found(method)),
        }
    }
