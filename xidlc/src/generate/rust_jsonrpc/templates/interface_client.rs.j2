            let endpoint = self
                .endpoint
                .clone()
                .ok_or(xidl_jsonrpc::Error::Protocol("missing endpoint for stream method"))?;
            let io = xidl_jsonrpc::connect(&endpoint)
                .await
                .map_err(xidl_jsonrpc::Error::Io)?;
            let mut source = xidl_jsonrpc::stream::open_server_stream_client(
                io,
                "{{ method.stream_rpc_name }}",
                ::serde_json::Value::Null,
            )
            .await?;
            let stream = async_stream::try_stream! {
                while let Some(item) = source.read().await {
                    let value: {{ method.item_ty }} = ::serde_json::from_value(item?)?;
                    yield value;
                }
            };
            Ok(xidl_jsonrpc::stream::Reader::new(xidl_jsonrpc::stream::boxed(stream)))
        }
    {% endfor %}
    {% for method in methods %}
        {% if method.kind == "stream_op" and method.stream_mode == "client" %}
            pub async fn {{ method.name }}(&self) -> Result<xidl_jsonrpc::stream::Writer<serde_json::Value, {{ method.ret }}>, xidl_jsonrpc::Error> {
                {{ connect_stream_endpoint("missing endpoint for stream method") }}
                let request = ::serde_json::json!({
                    "jsonrpc": "2.0",
                    "id": 1u64,
                    "method": "{{ method.rpc_name }}",
                    "params": ::serde_json::Value::Null,
                });
                let payload = ::serde_json::to_string(&request)?;
                tokio::io::AsyncWriteExt::write_all(&mut io, payload.as_bytes()).await?;
                tokio::io::AsyncWriteExt::write_all(&mut io, b"\n").await?;
                tokio::io::AsyncWriteExt::flush(&mut io).await?;
                let (read_half, write_half) = tokio::io::split(io);

                let (tx, mut rx) = tokio::sync::mpsc::channel(32);
                tokio::spawn(async move {
                    let mut writer = tokio::io::BufWriter::new(write_half);
                    while let Some(item) = rx.recv().await {
                        let value = match item {
                            Ok(v) => v,
                            Err(_) => break,
                        };
                        let line = match ::serde_json::to_string(&value) {
                            Ok(v) => v,
                            Err(_) => break,
                        };
                        if tokio::io::AsyncWriteExt::write_all(&mut writer, line.as_bytes()).await.is_err() {
                            break;
                        }
                        if tokio::io::AsyncWriteExt::write_all(&mut writer, b"\n").await.is_err() {
                            break;
                        }
                        if tokio::io::AsyncWriteExt::flush(&mut writer).await.is_err() {
                            break;
                        }
                    }
                    let _ = tokio::io::AsyncWriteExt::shutdown(&mut writer).await;
                });

                let response = tokio::spawn(async move {
                    let mut reader = tokio::io::BufReader::new(read_half);
                    let mut line = String::new();
                    let bytes = tokio::io::AsyncBufReadExt::read_line(&mut reader, &mut line).await?;
                    if bytes == 0 {
                        return Err(xidl_jsonrpc::Error::Protocol("missing stream handshake response"));
                    }
                    let ack: ::serde_json::Value = ::serde_json::from_str(&line)?;
                    if let Some(error) = ack.get("error").filter(|error| !error.is_null()) {
                        return Err(xidl_jsonrpc::Error::Rpc {
                            code: xidl_jsonrpc::ErrorCode::from(
                                error
                                    .get("code")
                                    .and_then(::serde_json::Value::as_i64)
                                    .unwrap_or(-32603),
                            ),
                            message: error
                                .get("message")
                                .and_then(::serde_json::Value::as_str)
                                .unwrap_or("stream handshake failed")
                                .to_string(),
                            data: error.get("data").cloned(),
                        });
                    }
                    if ack.get("id").and_then(::serde_json::Value::as_u64) != Some(1) {
                        return Err(xidl_jsonrpc::Error::Protocol("unexpected stream handshake id"));
                    }
                    let mut line = String::new();
                    let bytes = tokio::io::AsyncBufReadExt::read_line(&mut reader, &mut line).await?;
                    if bytes == 0 {
                        return Err(xidl_jsonrpc::Error::Protocol("missing stream response"));
                    }
                    let value: ::serde_json::Value = ::serde_json::from_str(&line)?;
                    {{ decode_stream_response(method) }}
                });
                Ok(xidl_jsonrpc::stream::Writer::new(tx, response))
            }
        {% elif method.kind == "stream_op" and method.stream_mode == "bidi" %}
            pub async fn {{ method.name }}(&self) -> Result<xidl_jsonrpc::stream::ReaderWriter<serde_json::Value, serde_json::Value>, xidl_jsonrpc::Error> {
