impl<S> {{ ident }}Client<S>
where
    S: xidl_jsonrpc::Stream + Unpin + Send + 'static,
{
    pub fn new(stream: S) -> Self {
        Self::from_stream(stream, None)
    }

    pub fn endpoint(&self) -> Option<&str> {
        self.endpoint.as_deref()
    }

    fn from_stream(stream: S, endpoint: Option<String>) -> Self {
        Self {
            client: std::sync::Arc::new(xidl_jsonrpc::ConcurrentClient::new(stream)),
            endpoint,
        }
    }
}

