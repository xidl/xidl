{% from "interface/client_decode.rs.j2" import build_client_auth %}
pub struct {{ ident }}Client {
    client: ::xidl_rust_axum::Client,
}

#[allow(non_snake_case)]
impl {{ ident }}Client {
    {% if version_parameter %}
        /// The API version sent by this client on every request.
        pub const API_VERSION: &'static str = {{ version_parameter.value }};
    {% endif %}
    {% for server in metadata.servers %}
        {% if server.description %}
            /// service: {{ server.description }}
            pub fn new_{{ server.description | to_case("snake_case") }}() -> Self {
                Self::new("{{ server.base_url }}")
            }
        {% endif %}
    {% endfor %}

    pub fn new(base_url: impl Into<String>) -> Self {
        Self {
            client: ::xidl_rust_axum::Client::new(base_url),
        }
    }

    {% if has_interface_security %}
        pub fn with_auth(
            base_url: impl Into<String>,
            auth: {{ interface_auth_ty }},
        ) -> Self {
            {% if interface_auth_ty == "xidl_rust_axum::ClientAuth" %}
                Self {
                    client: ::xidl_rust_axum::Client::with_auth(base_url, auth),
                }
            {% else %}
                let client_auth = {{ build_client_auth(interface_auth_ty, "auth") }};
                Self {
                    client: ::xidl_rust_axum::Client::with_auth(base_url, client_auth),
                }
            {% endif %}
        }
    {% endif %}

    pub fn with_http(
        base_url: impl Into<String>,
        http: ::xidl_rust_axum::reqwest::Client,
    ) -> Self {
        Self {
            client: ::xidl_rust_axum::Client::with_http(base_url, http),
        }
    }

    {% if has_interface_security %}
        pub fn with_http_and_auth(
            base_url: impl Into<String>,
            http: ::xidl_rust_axum::reqwest::Client,
            auth: {{ interface_auth_ty }},
        ) -> Self {
            {% if interface_auth_ty == "xidl_rust_axum::ClientAuth" %}
                Self {
                    client: ::xidl_rust_axum::Client::with_http_and_auth(base_url, http, auth),
                }
            {% else %}
                let client_auth = {{ build_client_auth(interface_auth_ty, "auth") }};
                Self {
                    client: ::xidl_rust_axum::Client::with_http_and_auth(base_url, http, client_auth),
                }
            {% endif %}
        }

        pub fn with_auth_override(
            &self,
            auth: Option<{{ interface_auth_ty }}>,
        ) -> Self {
            {% if interface_auth_ty == "xidl_rust_axum::ClientAuth" %}
                Self {
                    client: self.client.with_auth_override(auth),
                }
            {% else %}
                let client_auth = auth.map(|a| {{ build_client_auth(interface_auth_ty, "a") }});
                Self {
                    client: self.client.with_auth_override(client_auth),
                }
            {% endif %}
        }
    {% endif %}
}

{% include "interface/client_methods.rs.j2" %}
