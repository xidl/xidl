    pub fn router(self) -> xidl_rust_axum::axum::Router {
        let _svc = self.inner;
        xidl_rust_axum::axum::Router::new()
        {% for method in methods %}
            {% for path in method.paths %}
                .route("{{ path }}", xidl_rust_axum::axum::routing::{{ method.http_method_fn }}(Self::{{ method.name }}){% if method.cors_layer %}{{ method.cors_layer }}{% endif %})
            {% endfor %}
        {% endfor %}
        .with_state(_svc)
        {% if version_parameter and version_parameter.location == "Header" %}
            .layer(xidl_rust_axum::axum::middleware::map_response(Self::with_api_version))
        {% endif %}
    }
