    {% if version_parameter and version_parameter.location == "Header" %}
        async fn with_api_version(mut response: ::xidl_rust_axum::axum::response::Response) -> ::xidl_rust_axum::axum::response::Response {
            response.headers_mut().insert(
            ::xidl_rust_axum::axum::http::HeaderName::from_static({{ version_parameter.header_name }}),
            ::xidl_rust_axum::axum::http::HeaderValue::from_static({{ version_parameter.value }}),
            );
            response
        }
    {% endif %}
