{%- if kind == "map" -%}
{{ source }}.map(|value| {{ converted }})
{%- elif kind == "box" -%}
Box::new({{ converted }})
{%- elif kind == "sequence" -%}
{{ source }}{% if not bounded %}.into_iter(){% endif %}.map(|value| {{ converted }}){% if not bounded %}.collect(){% endif %}
{%- elif kind == "record" -%}
{{ source }}{% if bounded %}.map_values(|value| {{ converted }}){% else %}.into_iter().map(|(key, value)| (key, {{ converted }})).collect(){% endif %}
{%- endif -%}
