                    {% else %}let _ = value;
                    let body = xidl_rust_axum::serde_json::Value::Null;
                    {% endif %}Ok(xidl_rust_axum::stream::StreamFailure { status: {{ ex.status }}, body })
                }
            {% endfor %}
