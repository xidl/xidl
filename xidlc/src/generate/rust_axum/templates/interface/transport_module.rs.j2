#[allow(non_snake_case, non_camel_case_types, non_upper_case_globals, unused_imports)]
pub(super) mod {{ module.name }} {
    use super::*;
    {% for item in module.items %}
        #[derive(::serde::Serialize, ::serde::Deserialize)]
        {% if item.kind == "struct" %}
            pub struct {{ item.transport_ident }} {
                {% for field in item.fields %}
                    {% if field.flatten %}
                        #[serde(flatten)]
                    {% endif %}
                    {% if field.serde_rename %}
                        #[serde(rename = "{{ field.serde_rename }}")]
                    {% endif %}
                    {% if field.optional %}
                        #[serde(default, skip_serializing_if = "Option::is_none")]
                    {% endif %}
                    pub {{ field.name }}: {{ field.ty }},
                {% endfor %}
            }

            #[allow(unused_variables, unreachable_code)]
            impl From<{{ item.public_path }}> for {{ item.transport_ident }} {
                fn from(value: {{ item.public_path }}) -> Self {
                    Self {
                        {% for field in item.fields %}
                            {{ field.name }}{% if field.name != field.encode_expr %}: {{ field.encode_expr }}{% endif %},
                        {% endfor %}
                    }
                }
            }

            #[allow(unused_variables, unreachable_code)]
            impl From<{{ item.transport_ident }}> for {{ item.public_path }} {
                fn from(value: {{ item.transport_ident }}) -> Self {
                    Self {
                        {% for field in item.fields %}
                            {{ field.name }}{% if field.name != field.decode_expr %}: {{ field.decode_expr }}{% endif %},
                        {% endfor %}
                    }
                }
            }
        {% else %}
            pub enum {{ item.transport_ident }} {
                {% for variant in item.variants %}
                    {% if variant.serde_rename %}
                        #[serde(rename = "{{ variant.serde_rename }}")]
                    {% endif %}
                    {{ variant.ident }},
                {% endfor %}
            }

            #[allow(unused_variables, unreachable_code)]
            impl From<{{ item.public_path }}> for {{ item.transport_ident }} {
                fn from(value: {{ item.public_path }}) -> Self {
                    match value {
                        {% for variant in item.variants %}
                            {{ item.public_path }}::{{ variant.ident }} => Self::{{ variant.ident }},
                        {% endfor %}
                    }
                }
            }

            #[allow(unused_variables, unreachable_code)]
            impl From<{{ item.transport_ident }}> for {{ item.public_path }} {
                fn from(value: {{ item.transport_ident }}) -> Self {
                    match value {
                        {% for variant in item.variants %}
                            {{ item.transport_ident }}::{{ variant.ident }} => Self::{{ variant.ident }},
                        {% endfor %}
                    }
                }
            }
        {% endif %}

    {% endfor %}
}
