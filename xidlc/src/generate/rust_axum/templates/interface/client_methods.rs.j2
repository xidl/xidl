{% from "interface/client_decode.rs.j2" import response_header_decodes, decode_exception %}
{% from "interface/version_parameter.rs.j2" import pin_http, pin_ws with context %}
{% from "interface/client/return_type.rs.j2" import client_return_ty %}

{% macro apply_http_auth_requirements(method) %}
    {% if method.has_basic_auth %}
        auth_target.apply_auth(&mut req, xidl_rust_axum::ClientAuthRequirement::Basic)?;
    {% endif %}
    {% if method.has_bearer_auth %}
        auth_target.apply_auth(&mut req, xidl_rust_axum::ClientAuthRequirement::Bearer)?;
    {% endif %}
    {% for api_key in method.api_key_requirements %}
        auth_target.apply_auth(
            &mut req,
            xidl_rust_axum::ClientAuthRequirement::ApiKey {
                location: xidl_rust_axum::ApiKeyLocation::{{ api_key.location }},
                name: "{{ api_key.name }}",
            },
        )?;
    {% endfor %}
{% endmacro %}

{% macro apply_ws_auth_requirements(method) %}
    {% for api_key in method.api_key_requirements %}
        auth_target.apply_auth_to_ws_url(
            &mut ws_url,
            xidl_rust_axum::ClientAuthRequirement::ApiKey {
                location: xidl_rust_axum::ApiKeyLocation::{{ api_key.location }},
                name: "{{ api_key.name }}",
            },
        )?;
    {% endfor %}
    let mut auth_headers = {% if version_parameter %}req.headers().clone(){% else %}xidl_rust_axum::reqwest::header::HeaderMap::new(){% endif %};
    {% if method.has_basic_auth %}
        auth_target.apply_auth_headers(&mut auth_headers, xidl_rust_axum::ClientAuthRequirement::Basic)?;
    {% endif %}
    {% if method.has_bearer_auth %}
        auth_target.apply_auth_headers(&mut auth_headers, xidl_rust_axum::ClientAuthRequirement::Bearer)?;
    {% endif %}
    {% for api_key in method.api_key_requirements %}
        auth_target.apply_auth_headers(
            &mut auth_headers,
            xidl_rust_axum::ClientAuthRequirement::ApiKey {
                location: xidl_rust_axum::ApiKeyLocation::{{ api_key.location }},
                name: "{{ api_key.name }}",
            },
        )?;
    {% endfor %}
    {% if version_parameter %}{{ pin_ws() }}{% endif %}
    return xidl_rust_axum::stream::open_bidi_client_with_headers::<{{ method.request_item_ty }}, {{ method.response_ty }}>(&ws_url, auth_headers).await;
{% endmacro %}

#[allow(non_snake_case)]
impl {{ ident }}Client {
    {% for method in methods %}
        {% include 'interface/client/method_signature.rs.j2' %}
        {% include 'interface/client/request_build.rs.j2' %}
        {% include 'interface/client/call.rs.j2' %}
        {% include 'interface/client/response.rs.j2' %}
        }
    {% endfor %}
}
