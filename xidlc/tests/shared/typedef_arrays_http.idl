const long PAIR = 2;
module spatial {
    const long PAIR = 3;
    const long WIDTH = ::PAIR;
    const long TRIPLE = WIDTH + 1;
    struct Label { string name; };
    enum Mode { Foot, Van };
    typedef Label Pair[WIDTH], Triple[TRIPLE];
    typedef Pair Grid[WIDTH][TRIPLE];
    typedef sequence<Pair> Batches[WIDTH];
    typedef map<string, Pair> LookupRows[WIDTH];
    typedef Mode ModePair[WIDTH];
    typedef double Coordinates[WIDTH], Bounds[WIDTH * WIDTH];
};

typedef spatial::Pair RootPair;

module client {
    const long WIDTH = 9;
    typedef long Label;
    typedef long RootPair;
    typedef spatial::Pair ImportedPair;
    struct Envelope {
        ImportedPair pair;
        @optional ImportedPair optional_pair;
        spatial::Triple triple;
        spatial::Grid grid;
        spatial::Batches batches;
        spatial::LookupRows rows;
        spatial::ModePair modes;
        spatial::Bounds bounds;
        @optional spatial::Coordinates coordinates;
        ImportedPair slots[::PAIR];
        ::RootPair rooted;
    };
    interface Geo {
        @post(path="/envelopes") Envelope echo(@body Envelope value);
        @post(path="/pairs") ImportedPair pair(@body ImportedPair value);
        @post(path="/coordinates") spatial::Coordinates locate(@body spatial::Coordinates value);
    };
};
