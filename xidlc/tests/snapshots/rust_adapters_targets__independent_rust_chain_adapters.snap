    fn locate<T>(result: VersionedResult<T>, path: &str) -> VersionedResult<T> {
        result
            .map_err(|error| UnsupportedProjection {
                type_path: format!("{path}.{}", error.type_path),
                ..error
            })
    }
    fn map_sequence<S, T>(
        source: &[S],
        convert: impl Fn(&S) -> VersionedResult<T>,
        path: &str,
    ) -> VersionedResult<Vec<T>> {
        source.iter().map(|item| locate(convert(item), path)).collect()
    }
    /// Projects one adjacent declaration by borrowing its source value.
    pub fn booking_upcast_from_v_2026_06_01(
        source: &v2026_06_01::Booking,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2026_10_01::Booking> {
        let refusal = |reason: &str| UnsupportedProjection {
            version: "v2026_06_01".into(),
            direction: Direction::Upcast,
            type_path: "Booking".into(),
            reason: reason.into(),
        };
        let decision = adapters.booking_upcast_from_v_2026_06_01(source)?;
        let projected_0 = Ok::<
            _,
            UnsupportedProjection,
        >(::std::clone::Clone::clone(&source.id))?;
        let projected_1 = Ok::<
            _,
            UnsupportedProjection,
        >(::std::clone::Clone::clone(&source.title))?;
        let projected_2 = map_sequence(
            &source.roster,
            |item| Ok::<_, UnsupportedProjection>(::std::clone::Clone::clone(item)),
            "Booking.roster",
        )?;
        let projected_3 = (&source.owner)
            .as_ref()
            .map(|item| Ok::<_, UnsupportedProjection>(::std::clone::Clone::clone(item)))
            .transpose()?;
        Ok(v2026_10_01::Booking {
            id: projected_0,
            title: projected_1,
            roster: projected_2,
            owner: projected_3,
            items: decision.items,
            locked: Some(decision.locked),
        })
    }
