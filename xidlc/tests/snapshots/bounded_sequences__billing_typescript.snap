import * as $xidl_root from "./bounded_sequences.zod";

    export namespace codes {
    export const RetryStateSchema = z.enum(["true", "retryable"]);

        export const StateSchema = RetryStateSchema;
}

    export namespace billing {

        export const InvoiceIdsSchema = z.array(z.number().min(-2147483648).max(2147483647).refine(Number.isInteger, "expected an integer")).max(2);

        export const RegionsSchema = z.record(z.string(), InvoiceIdsSchema).refine((value) => Object.keys(value).length <= 2, "map maximum length exceeded");

        export const TokenSchema = z.string();

        export const TotalSchema = z.object({
            
                count: z.number().min(-2147483648).max(2147483647).refine(Number.isInteger, "expected an integer")
            
        });
    export const RegionSchema = z.enum(["eu", "us"]);

        export const BatchRejectedSchema = z.object({
            
                ids: InvoiceIdsSchema,
            
                regions: z.record(z.string(), InvoiceIdsSchema).refine((value) => Object.keys(value).length <= 2, "map maximum length exceeded"),
            
                retry: InvoiceIdsSchema,
            
                tokens: InvoiceIdsSchema,
            
                detail: TotalSchema,
            
                state: $xidl_root.codes.StateSchema,
            
                tag: TokenSchema,
            
                token: TokenSchema
            
        });

        export const BatchSchema = z.object({
            
                invoices: InvoiceIdsSchema,
            
                windows: z.array(InvoiceIdsSchema).max(2),
            
                regions: RegionsSchema,
            
                days: z.array(InvoiceIdsSchema).length(2),
            
                retry: InvoiceIdsSchema.nullish().transform((value) => value ?? undefined)
            
        });

        export const ExportSchema = z.union([z.object({ ids: InvoiceIdsSchema }), z.object({ bytes: z.array(z.number().min(0).max(255).refine(Number.isInteger, "expected an integer")).max(2) })]);
