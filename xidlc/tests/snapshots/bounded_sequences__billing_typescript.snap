import * as $xidl_root from "./bounded_sequences";
export namespace codes {
    export type RetryState = "true" | "retryable";


    export type State = RetryState;
}
export namespace billing {


    export type InvoiceIds = Array<number>;


    export type Regions = Record<string, InvoiceIds>;


    export type Token = string;
    export interface Total {
        count: number;
    }
    export type Region = "eu" | "us";
    export interface BatchRejected {
        ids: InvoiceIds;
        regions: Record<string, InvoiceIds>;
        retry: InvoiceIds;
        tokens: InvoiceIds;
        detail: Total;
        state: $xidl_root.codes.State;
        tag: Token;
        token: Token;
    }
    export interface Batch {
        invoices: InvoiceIds;
        windows: Array<InvoiceIds>;
        regions: Regions;
        days: Array<InvoiceIds>;
        retry?: InvoiceIds;
    }


    export type Export = { ids: InvoiceIds } | { bytes: Array<number> };
}
