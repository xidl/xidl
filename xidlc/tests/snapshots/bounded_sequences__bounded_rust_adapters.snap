    fn locate<T>(result: VersionedResult<T>, path: &str) -> VersionedResult<T> {
        result
            .map_err(|error| UnsupportedProjection {
                type_path: format!("{path}.{}", error.type_path),
                ..error
            })
    }
    fn map_sequence<S, T, C>(
        source: &[S],
        convert: impl Fn(&S) -> VersionedResult<T>,
        refusal: impl Fn(&str) -> UnsupportedProjection,
        path: &str,
    ) -> VersionedResult<C>
    where
        C: TryFrom<Vec<T>>,
        C::Error: ::std::fmt::Display,
    {
        let values = source
            .iter()
            .map(|item| locate(convert(item), path))
            .collect::<VersionedResult<Vec<_>>>()?;
        C::try_from(values).map_err(|error| refusal(&error.to_string()))
    }
    fn map_record<K: Ord, V, L: Ord, W, C>(
        source: &::std::collections::BTreeMap<K, V>,
        key: impl Fn(&K) -> VersionedResult<L>,
        value: impl Fn(&V) -> VersionedResult<W>,
        refusal: impl Fn(&str) -> UnsupportedProjection,
        path: &str,
    ) -> VersionedResult<C>
    where
        C: TryFrom<::std::collections::BTreeMap<L, W>>,
        C::Error: ::std::fmt::Display,
    {
        let mut target = ::std::collections::BTreeMap::new();
        for (old_key, old_value) in source {
            let next_key = locate(key(old_key), path)?;
            let next_value = locate(value(old_value), path)?;
            if target.insert(next_key, next_value).is_some() {
                return Err(refusal("map key projection is not injective"));
            }
        }
        C::try_from(target).map_err(|error| refusal(&error.to_string()))
    }
