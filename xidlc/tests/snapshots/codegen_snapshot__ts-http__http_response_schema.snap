// Code generated by xidlc-v0.0.1-snapshot. DO NOT EDIT.


import { z } from "zod";
import { xjson } from "xidl-typescript-codec";

    export const ShapeKindSchema = z.enum(["kindRound", "squared"]);

    
    export const ShapeSchema = z.object({
        
            id: xjson(z.coerce.string(), {"name":"shape_id"}),
        
            note: z.coerce.string().nullish().transform((value) => value ?? undefined),
        
            kind: ShapeKindSchema
        
    });

    
    export const AreaSchema = z.union([z.object({ circle: z.coerce.number().int().nonnegative() }), z.object({ square: z.coerce.number().int().nonnegative() }), z.object({ fallback: z.coerce.number().int().nonnegative() })]);
