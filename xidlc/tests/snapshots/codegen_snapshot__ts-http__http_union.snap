import { z } from "zod";
import { xjson } from "xidl-typescript-codec";

    
    export const FileMetaSchema = z.object({
        
            id: z.coerce.string(),
        
            etag: z.coerce.string()
        
    });

    
    export const NotFoundSchema = z.object({
        
            code: z.coerce.number().int().nonnegative(),
        
            msg: z.coerce.string()
        
    });

    
    export const FileResponseSchema = z.union([z.object({ meta: FileMetaSchema }), z.object({ raw: z.array(z.coerce.number().int().nonnegative()) })]);

    export const ContentTypeSchema = z.enum(["application/json", "application/octet-stream", "text/plain"]);
