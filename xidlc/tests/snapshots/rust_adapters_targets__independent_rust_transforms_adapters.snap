                decode_and_upcast_directory_roster_from_v_2026_04_01(wire, adapters)
            }
            Version::V20260701 => {
                decode_and_upcast_directory_roster_from_v_2026_07_01(wire, adapters)
            }
        }
    }
    /// Retain the original owned Head outcome when any projection refuses.
    pub fn downcast_directory_roster_outcome(
        version: Version,
        head: Result<Vec<v2026_07_01::Profile>, ::xidl_rust_axum::Error>,
        stored: &dyn StoredValues,
        adapters: &dyn VersionAdapters,
    ) -> ProjectionOutcome<
        DirectoryRosterOutcome,
        Result<Vec<v2026_07_01::Profile>, ::xidl_rust_axum::Error>,
    > {
        match version {
            Version::V20260101 => {
                match downcast_directory_roster_from_v_2026_01_01_outcome(
                    head,
                    stored,
                    adapters,
                ) {
                    ProjectionOutcome::Projected(value) => {
                        ProjectionOutcome::Projected(
                            DirectoryRosterOutcome::V20260101(value),
                        )
                    }
                    ProjectionOutcome::Unsupported { head, error } => {
                        ProjectionOutcome::Unsupported {
                            head,
                            error,
                        }
                    }
                }
            }
            Version::V20260401 => {
                match downcast_directory_roster_from_v_2026_04_01_outcome(
                    head,
                    stored,
                    adapters,
                ) {
                    ProjectionOutcome::Projected(value) => {
                        ProjectionOutcome::Projected(
                            DirectoryRosterOutcome::V20260401(value),
                        )
                    }
                    ProjectionOutcome::Unsupported { head, error } => {
                        ProjectionOutcome::Unsupported {
                            head,
                            error,
                        }
                    }
                }
            }
            Version::V20260701 => {
                match downcast_directory_roster_from_v_2026_07_01_outcome(
                    head,
                    adapters,
                ) {
                    ProjectionOutcome::Projected(value) => {
                        ProjectionOutcome::Projected(
                            DirectoryRosterOutcome::V20260701(value),
                        )
                    }
                    ProjectionOutcome::Unsupported { head, error } => {
                        ProjectionOutcome::Unsupported {
                            head,
                            error,
                        }
                    }
                }
            }
        }
    }
    /// Execute a Head handler once; it returns the stored values older versions still read.
    pub async fn dispatch_directory_roster<F, Fut, R>(
        version: Version,
        wire: ::serde_json::Value,
        handler: F,
        adapters: &(dyn VersionAdapters + Sync),
    ) -> Result<
        ProjectionOutcome<
            DirectoryRosterOutcome,
            Result<Vec<v2026_07_01::Profile>, ::xidl_rust_axum::Error>,
        >,
        AdaptationError,
    >
    where
        F: FnOnce(DirectoryRosterRequestV20260701, VersionContext) -> Fut,
        Fut: ::std::future::Future<
            Output = HeadOutcome<Vec<v2026_07_01::Profile>, ::xidl_rust_axum::Error, R>,
        >,
        R: StoredValues,
    {
        let input = decode_and_upcast_directory_roster(version, wire, adapters)?;
        let head = handler(
                input,
                VersionContext {
                    original_version: version,
                },
            )
            .await;
        Ok(
            downcast_directory_roster_outcome(
                version,
                head.outcome,
                &head.stored,
                adapters,
            ),
        )
    }
}
