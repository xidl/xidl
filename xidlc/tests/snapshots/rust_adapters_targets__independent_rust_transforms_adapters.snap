            version: "v2026_04_01".into(),
            direction: Direction::Downcast,
            type_path: "Missing".into(),
            reason: reason.into(),
        };
        let projected_0 = Ok::<
            _,
            UnsupportedProjection,
        >(::std::clone::Clone::clone(&source.id))?;
        Ok(v2026_01_01::Missing {
            id: projected_0,
        })
    }
