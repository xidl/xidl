        ) -> VersionedResult<v2026_04_01::RouteProtocol>;
        fn directory_profile_sealed_error_downcast_to_v_2026_04_01(
            &self,
            source: &v2026_07_01::Sealed,
        ) -> VersionedResult<v2026_04_01::DirectoryProfileError>;
    }
