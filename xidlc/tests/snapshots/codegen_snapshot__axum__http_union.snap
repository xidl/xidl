            .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
        if resp.status().is_success() {
            let content_type = resp
                .headers()
                .get(::xidl_rust_axum::reqwest::header::CONTENT_TYPE)
                .and_then(|value| value.to_str().ok())
                .unwrap_or_default()
                .to_string();
            let headers = resp.headers().clone();
            let etag: String = match headers.get("ETag") {
                Some(header_value) => {
                    let header_str = header_value
                        .to_str()
                        .map_err(|err| xidl_rust_axum::Error::new(
                            400,
                            format!("{err:?}"),
                        ))?;
                    header_str.to_string()
                }
                None => ::core::default::Default::default(),
            };
            if xidl_rust_axum::http::media_type_eq(
                &content_type,
                xidl_rust_axum::http::ContentType::Json.as_str(),
            ) {
                let body = resp
                    .bytes()
                    .await
                    .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
                let payload: FileMeta = xidl_rust_axum::DeserializeFactory::new(
                        xidl_rust_axum::http::ContentType::Json.as_str(),
                    )
                    .from_slice(&body)?;
                return Ok(FilesGetFileResponse {
                    r#return: FileResponse::Json(payload),
                    etag,
                });
            }
            if xidl_rust_axum::http::media_type_eq(
                &content_type,
                xidl_rust_axum::http::ContentType::OctetStream.as_str(),
            ) {
                let payload = resp
                    .bytes()
                    .await
                    .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?
                    .to_vec();
                return Ok(FilesGetFileResponse {
                    r#return: FileResponse::OctetStream(payload),
                    etag,
                });
            }
            let status = resp.status();
            let body = resp.json::<xidl_rust_axum::ErrorBody>().await.ok();
            Err(
                FilesGetFileError::Framework(
                    xidl_rust_axum::Error::from_http_response(status, body),
                ),
            )
        } else {
            let status = resp.status();
            if status.as_u16() == 404 {
                let headers = resp.headers().clone();
                let mut value: NotFound = resp
                    .json::<NotFound>()
                    .await
                    .map_err(|err| xidl_rust_axum::Error::new(
                        status.as_u16(),
                        format!("exception NotFound body: {err}"),
                    ))?;
                return Err(FilesGetFileError::NotFound(value));
            }
            let body = resp.json::<xidl_rust_axum::ErrorBody>().await.ok();
            Err(
                FilesGetFileError::Framework(
                    xidl_rust_axum::Error::from_http_response(status, body),
                ),
            )
        }
    }
}
