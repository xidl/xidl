        ) -> ::xidl_rust_axum::Result<::xidl_rust_axum::axum::response::Response> {
            let _ = &headers;
            let xidl_requested_api_version = xidl_rust_axum::api_version::ApiVersionLocation::Query
                .extract(&headers, &uri, "api-version");
            svc.resolve_api_version(xidl_requested_api_version.as_deref(), uri.path())?;
            let req_headers = headers.clone();
            let svc = svc.clone();
            let mut resp = ws
                .on_upgrade(move |socket| async move {
                    let bidi = xidl_rust_axum::stream::open_bidi_server::<
                        ChatChatRequest,
                        ChatChatResponse,
                    >(socket);
                    let error_sender = bidi.error_sender();
                    let req = ::xidl_rust_axum::Request::new(req_headers, bidi);
                    if let Err(err) = svc.chat(req).await {
                        if let Some(tx) = error_sender {
                            let _ = tx.send(Err(err)).await;
                        }
                    }
                });
            return Ok(resp);
        }
    }
    impl<T> xidl_rust_axum::Service for ChatServer<T>
    where
        T: Chat + Send + Sync + 'static,
    {
        fn into_router(self) -> xidl_rust_axum::axum::Router {
            self.router()
        }
    }
    pub struct ChatClient {
        client: ::xidl_rust_axum::Client,
    }
    #[allow(non_snake_case)]
    impl ChatClient {
        /// The wire version this client pins on every request.
        pub const API_VERSION: &'static str = "2025-06";
        pub fn new(base_url: impl Into<String>) -> Self {
            Self {
                client: ::xidl_rust_axum::Client::new(base_url),
            }
        }
        pub fn with_http(
            base_url: impl Into<String>,
            http: ::xidl_rust_axum::reqwest::Client,
        ) -> Self {
            Self {
                client: ::xidl_rust_axum::Client::with_http(base_url, http),
            }
        }
    }
    #[allow(non_snake_case)]
    impl ChatClient {
        #[allow(
            clippy::useless_conversion,
            unused_mut,
            unreachable_code,
            unused_variables
        )]
        pub async fn history(
            &self,
            room: String,
        ) -> Result<String, xidl_rust_axum::Error> {
            let xidl_path = "/history".to_string();
            let mut req = self
                .client
                .http()
                .request(
                    xidl_rust_axum::reqwest::Method::GET,
                    self.client.url(&xidl_path),
                )
                .build()
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            req.headers_mut()
                .insert(
                    xidl_rust_axum::reqwest::header::ACCEPT,
                    xidl_rust_axum::reqwest::header::HeaderValue::from_str("text/plain")
                        .map_err(|err| xidl_rust_axum::Error::new(
                            400,
                            format!("{err:?}"),
                        ))?,
                );
            let query = ChatHistoryRequestOutQuery { room };
            let query = xidl_rust_axum::serde_urlencoded::to_string(&query)
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            if !query.is_empty() {
                req.url_mut().set_query(Some(&query));
            }
            let xidl_version_query = xidl_rust_axum::serde_urlencoded::to_string([
                    ("api-version", Self::API_VERSION),
                ])
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            let xidl_existing_query = req
                .url_mut()
                .query()
                .unwrap_or_default()
                .to_string();
            if xidl_existing_query.is_empty() {
                req.url_mut().set_query(Some(&xidl_version_query));
            } else {
                req.url_mut()
                    .set_query(
                        Some(
                            &::std::format!("{xidl_existing_query}&{xidl_version_query}"),
                        ),
                    );
            }
            let auth_target = &self.client;
            let _ = auth_target;
            let resp = self
                .client
                .http()
                .execute(req)
                .await
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            if resp.status().is_success() {
                let body = resp
                    .bytes()
                    .await
                    .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
                let body: String = xidl_rust_axum::DeserializeFactory::new("text/plain")
                    .from_slice(&body)?;
                Ok(body)
            } else {
                let status = resp.status();
                let body = resp.json::<xidl_rust_axum::ErrorBody>().await.ok();
                Err(xidl_rust_axum::Error::from_http_response(status, body))
            }
        }
        #[allow(
            clippy::useless_conversion,
            unused_mut,
            unreachable_code,
            unused_variables
        )]
        pub async fn chat(
            &self,
            room: String,
            text: String,
        ) -> Result<
            xidl_rust_axum::stream::ReaderWriter<ChatChatRequest, ChatChatResponse>,
            xidl_rust_axum::Error,
        > {
            let xidl_path = "/chat".to_string();
            let mut req = self
                .client
                .http()
                .request(
                    xidl_rust_axum::reqwest::Method::GET,
                    self.client.url(&xidl_path),
                )
                .build()
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            req.headers_mut()
                .insert(
                    xidl_rust_axum::reqwest::header::ACCEPT,
                    xidl_rust_axum::reqwest::header::HeaderValue::from_str(
                            "application/x-ndjson",
                        )
                        .map_err(|err| xidl_rust_axum::Error::new(
                            400,
                            format!("{err:?}"),
                        ))?,
                );
            let auth_target = &self.client;
            let _ = auth_target;
            let mut ws_url = self.client.ws_url(&xidl_path)?;
            let xidl_version_query = xidl_rust_axum::serde_urlencoded::to_string([
                    ("api-version", Self::API_VERSION),
                ])
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            ws_url.push(if ws_url.contains('?') { '&' } else { '?' });
            ws_url.push_str(&xidl_version_query);
            return xidl_rust_axum::stream::open_bidi_client::<
                ChatChatRequest,
                ChatChatResponse,
            >(&ws_url)
                .await;
        }
    }
}
