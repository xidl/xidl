                                ::xidl_rust_axum::axum::http::StatusCode::from_u16(200)
                                    .unwrap(),
                            )
                            .header(
                                ::xidl_rust_axum::axum::http::header::CONTENT_TYPE,
                                "application/json",
                            )
                            .body(::xidl_rust_axum::axum::body::Body::from(body))
                            .map_err(|err| xidl_rust_axum::Error::new(
                                500,
                                format!("{err:?}"),
                            ))?
                    };
                    resp
                }
                Err(err) => {
                    ::xidl_rust_axum::axum::response::IntoResponse::into_response(err)
                }
            };
            Ok(resp)
        }
        #[allow(
            clippy::let_and_return,
            clippy::needless_return,
            clippy::useless_conversion,
            unused_mut,
            unreachable_code,
            clippy::let_unit_value,
            unused_variables
        )]
        async fn ship(
            ::xidl_rust_axum::axum::extract::State(
                svc,
            ): ::xidl_rust_axum::axum::extract::State<::std::sync::Arc<T>>,
            headers: ::xidl_rust_axum::axum::http::HeaderMap,
            uri: ::xidl_rust_axum::axum::http::Uri,
            request: DepotShipRequest,
        ) -> ::xidl_rust_axum::Result<::xidl_rust_axum::axum::response::Response> {
            let _ = &headers;
            if !xidl_rust_axum::http::accepts_media_type(&headers, "application/json") {
                return Err(xidl_rust_axum::Error::not_acceptable());
            }
            let DepotShipRequest { parcel, lane } = request;
            let parcel: Parcel = parcel.into();
            let lane: String = lane;
            let mut resp = match svc.ship(parcel, lane).await {
                Ok(resp_value) => {
                    let mut resp = {
                        let body_value: __xidl_out_Depot::v3_Status = resp_value.into();
                        let _ = &body_value;
                        let body = xidl_rust_axum::SerializeFactory::new(
                                "application/json",
                            )
                            .to_vec(&body_value)?;
                        ::xidl_rust_axum::axum::response::Response::builder()
                            .status(
                                ::xidl_rust_axum::axum::http::StatusCode::from_u16(200)
                                    .unwrap(),
                            )
                            .header(
                                ::xidl_rust_axum::axum::http::header::CONTENT_TYPE,
                                "application/json",
                            )
                            .body(::xidl_rust_axum::axum::body::Body::from(body))
                            .map_err(|err| xidl_rust_axum::Error::new(
                                500,
                                format!("{err:?}"),
                            ))?
                    };
                    resp
                }
                Err(err) => {
                    ::xidl_rust_axum::axum::response::IntoResponse::into_response(err)
                }
            };
            Ok(resp)
        }
    }
    impl<T> xidl_rust_axum::Service for DepotServer<T>
    where
        T: Depot + Send + Sync + 'static,
    {
        fn into_router(self) -> xidl_rust_axum::axum::Router {
            self.router()
        }
    }
    pub struct DepotClient {
        client: ::xidl_rust_axum::Client,
    }
    #[allow(non_snake_case)]
    impl DepotClient {
        pub fn new(base_url: impl Into<String>) -> Self {
            Self {
                client: ::xidl_rust_axum::Client::new(base_url),
            }
        }
        pub fn with_http(
            base_url: impl Into<String>,
            http: ::xidl_rust_axum::reqwest::Client,
        ) -> Self {
            Self {
                client: ::xidl_rust_axum::Client::with_http(base_url, http),
            }
        }
    }
    #[allow(non_snake_case)]
    impl DepotClient {
        #[allow(
            clippy::useless_conversion,
            unused_mut,
            unreachable_code,
            unused_variables
        )]
        pub async fn get(
            &self,
            sku: String,
            status: Option<Status>,
        ) -> Result<Parcel, DepotGetError> {
            let xidl_path = "/parcels/{sku}".to_string();
            let xidl_path = xidl_path.replace("{sku}", &sku.to_string());
            let mut req = self
                .client
                .http()
                .request(
                    xidl_rust_axum::reqwest::Method::GET,
                    self.client.url(&xidl_path),
                )
                .build()
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            req.headers_mut()
                .insert(
                    xidl_rust_axum::reqwest::header::ACCEPT,
                    xidl_rust_axum::reqwest::header::HeaderValue::from_str(
                            "application/json",
                        )
                        .map_err(|err| xidl_rust_axum::Error::new(
                            400,
                            format!("{err:?}"),
                        ))?,
                );
            let query = DepotGetRequestOutQuery {
                status: status.map(|value| value.into()),
            };
            let query = xidl_rust_axum::serde_urlencoded::to_string(&query)
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            if !query.is_empty() {
                req.url_mut().set_query(Some(&query));
            }
            let auth_target = &self.client;
            let _ = auth_target;
            let resp = self
                .client
                .http()
                .execute(req)
                .await
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            if resp.status().is_success() {
                let body = resp
                    .bytes()
                    .await
                    .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
                let body: __xidl_in_Depot::v3_Parcel = xidl_rust_axum::DeserializeFactory::new(
                        "application/json",
                    )
                    .from_slice(&body)?;
                Ok(body.into())
            } else {
                let status = resp.status();
                if status.as_u16() == 404 {
                    let headers = resp.headers().clone();
                    let mut value: ParcelNotFound = resp
                        .json::<ParcelNotFound>()
                        .await
                        .map_err(|err| xidl_rust_axum::Error::new(
                            status.as_u16(),
                            format!("exception ParcelNotFound body: {err}"),
                        ))?;
                    return Err(DepotGetError::ParcelNotFound(value));
                }
                if status.as_u16() == 422 {
                    let headers = resp.headers().clone();
                    let mut value: CarrierRejected = resp
                        .json::<CarrierRejected>()
                        .await
                        .map_err(|err| xidl_rust_axum::Error::new(
                            status.as_u16(),
                            format!("exception CarrierRejected body: {err}"),
                        ))?;
                    return Err(DepotGetError::CarrierRejected(value));
                }
                let body = resp.json::<xidl_rust_axum::ErrorBody>().await.ok();
                Err(
                    DepotGetError::Framework(
                        xidl_rust_axum::Error::from_http_response(status, body),
                    ),
                )
            }
        }
        #[allow(
            clippy::useless_conversion,
            unused_mut,
            unreachable_code,
            unused_variables
        )]
        pub async fn ship(
            &self,
            parcel: Parcel,
            lane: String,
        ) -> Result<Status, xidl_rust_axum::Error> {
            let xidl_path = "/parcels".to_string();
            let mut req = self
                .client
                .http()
                .request(
                    xidl_rust_axum::reqwest::Method::POST,
                    self.client.url(&xidl_path),
                )
                .build()
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            req.headers_mut()
                .insert(
                    xidl_rust_axum::reqwest::header::ACCEPT,
                    xidl_rust_axum::reqwest::header::HeaderValue::from_str(
                            "application/json",
                        )
                        .map_err(|err| xidl_rust_axum::Error::new(
                            400,
                            format!("{err:?}"),
                        ))?,
                );
            let query = DepotShipRequestOutQuery { lane };
            let query = xidl_rust_axum::serde_urlencoded::to_string(&query)
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            if !query.is_empty() {
                req.url_mut().set_query(Some(&query));
            }
            let auth_target = &self.client;
            let _ = auth_target;
            let body = DepotShipRequestOutBody {
                parcel: parcel.into(),
            };
            let body = xidl_rust_axum::SerializeFactory::new("application/json")
                .to_vec(&body)?;
            req.headers_mut()
                .insert(
                    xidl_rust_axum::reqwest::header::CONTENT_TYPE,
                    xidl_rust_axum::reqwest::header::HeaderValue::from_str(
                            "application/json",
                        )
                        .map_err(|err| xidl_rust_axum::Error::new(
                            400,
                            format!("{err:?}"),
                        ))?,
                );
            *req.body_mut() = Some(xidl_rust_axum::reqwest::Body::from(body));
            let resp = self
                .client
                .http()
                .execute(req)
                .await
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            if resp.status().is_success() {
                let body = resp
                    .bytes()
                    .await
                    .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
                let body: __xidl_in_Depot::v3_Status = xidl_rust_axum::DeserializeFactory::new(
                        "application/json",
                    )
                    .from_slice(&body)?;
                Ok(body.into())
            } else {
                let status = resp.status();
                let body = resp.json::<xidl_rust_axum::ErrorBody>().await.ok();
                Err(xidl_rust_axum::Error::from_http_response(status, body))
            }
        }
    }
}

/// Version adapters: pure projections between the declared API versions.
///
/// The conversion functions below are mechanical. The decisions the
/// compiler cannot make live on [`VersionAdapters`], which the application
/// implements; every hook body must be pure — no I/O, no clock, no
/// database — so the same input always projects the same way. A hook that
/// cannot decide returns [`UnsupportedProjection`] instead of inventing
/// data, and the application renders that refusal as a wire error.
///
/// Rust deserializes into the served version's own types, so wire members
/// the served version does not declare are dropped by serde's default
/// rules; rejecting foreign members on the wire stays the transport
/// layer's job.
pub mod version_adapters {
    use super::{v1, v2, v3};
    /// Data carried when a projection would have to invent information.
    #[derive(Debug, Clone)]
    pub struct UnsupportedProjection {
        pub version: String,
        pub direction: Direction,
        pub type_path: String,
        pub reason: String,
    }
    /// Which way a refused projection was heading.
    #[derive(Debug, Clone, Copy)]
    pub enum Direction {
        Upcast,
        Downcast,
    }
    /// The projected value, or why the projection refused.
    pub type VersionedResult<T> = ::std::result::Result<T, UnsupportedProjection>;
    /// Marker a hook sets to prove a retired member was consciously dropped.
    #[derive(Debug, Clone, Copy)]
    pub struct Ignored;
    /// The only legal value for a retired decision field.
    pub const IGNORED: Ignored = Ignored;
    /// Hooks the application implements. Methods stay synchronous so the
    /// generated conversions can take the trait by reference.
    pub trait VersionAdapters {
        fn parcel_upcast_from_v1(
            &self,
            source: &v1::Parcel,
        ) -> VersionedResult<ParcelUpcastDecisionFromV1>;
        fn parcel_downcast_to_v1(
            &self,
            source: &v2::Parcel,
        ) -> VersionedResult<ParcelDowncastDecisionToV1>;
        fn status_upcast_from_v1(
            &self,
            value: &v1::Status,
        ) -> VersionedResult<v2::Status>;
        fn status_downcast_to_v1(
            &self,
            value: &v2::Status,
        ) -> VersionedResult<v1::Status>;
        fn depot_get_carrier_rejected_downcast_to_v1(
            &self,
            head: &v2::CarrierRejected,
        ) -> VersionedResult<v1::DepotGetError>;
        fn depot_ship_upcast_from_v1(
            &self,
            parcel: &v1::Parcel,
        ) -> VersionedResult<DepotShipUpcastDecisionFromV1>;
    }
    /// Decision fields a hook supplies; [`IGNORED`] proves a retired member
    /// was consciously dropped.
    pub struct ParcelUpcastDecisionFromV1 {
        pub return_label: Ignored,
        pub color: Ignored,
        pub code_v1: Ignored,
        pub code_v2: String,
        pub carrier: String,
    }
    /// Decision fields a hook supplies; [`IGNORED`] proves a retired member
    /// was consciously dropped.
    pub struct ParcelDowncastDecisionToV1 {
        pub return_label: v1::Sku,
        pub code_v1: String,
    }
    /// Decision fields a hook supplies; [`IGNORED`] proves a retired member
    /// was consciously dropped.
    pub struct DepotShipUpcastDecisionFromV1 {
        pub lane: String,
    }
    /// The head-shaped parameters of one request, projected from an older
    /// version. The fields are the head handler's parameters in declaration
    /// order.
    pub struct DepotGetFromV1 {
        pub sku: String,
        pub status: ::std::option::Option<v2::Status>,
    }
    /// The head-shaped parameters of one request, projected from an older
    /// version. The fields are the head handler's parameters in declaration
    /// order.
    pub struct DepotShipFromV1 {
        pub parcel: v2::Parcel,
        pub lane: String,
    }
    /// The head-shaped parameters of one request, projected from an older
    /// version. The fields are the head handler's parameters in declaration
    /// order.
    pub struct DepotGetFromV2 {
        pub sku: String,
        pub status: ::std::option::Option<v3::Status>,
    }
    /// The head-shaped parameters of one request, projected from an older
    /// version. The fields are the head handler's parameters in declaration
    /// order.
    pub struct DepotShipFromV2 {
        pub parcel: v3::Parcel,
        pub lane: String,
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn parcel_upcast_from_v1(
        source: v1::Parcel,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::Parcel> {
        let decision = adapters.parcel_upcast_from_v1(&source)?;
        let converted0 = sku_upcast_from_v1(source.sku, adapters)?;
        Ok(v2::Parcel {
            sku: converted0,
            code_v2: decision.code_v2,
            carrier: decision.carrier,
            note: ::std::option::Option::None,
        })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn parcel_downcast_to_v1(
        source: v2::Parcel,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v1::Parcel> {
        let decision = adapters.parcel_downcast_to_v1(&source)?;
        let converted0 = sku_downcast_to_v1(source.sku, adapters)?;
        Ok(v1::Parcel {
            sku: converted0,
            return_label: decision.return_label,
            code_v1: decision.code_v1,
            color: ::std::option::Option::None,
        })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn parcel_not_found_downcast_to_v1(
        source: v2::ParcelNotFound,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v1::ParcelNotFound> {
        Ok(v1::ParcelNotFound {
            sku: source.sku,
        })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn sku_upcast_from_v1(
        source: v1::Sku,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::Sku> {
        Ok(v2::Sku { value: source.value })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn sku_downcast_to_v1(
        source: v2::Sku,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v1::Sku> {
        Ok(v1::Sku { value: source.value })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn status_upcast_from_v1(
        source: v1::Status,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::Status> {
        match source {
            v1::Status::processing => Ok(v2::Status::processing),
            other => adapters.status_upcast_from_v1(&other),
        }
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn status_downcast_to_v1(
        source: v2::Status,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v1::Status> {
        match source {
            v2::Status::processing => Ok(v1::Status::processing),
            other => adapters.status_downcast_to_v1(&other),
        }
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn upcast_depot_get_from_v1(
        sku: String,
        status: ::std::option::Option<v1::Status>,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<DepotGetFromV1> {
        let converted1 = match status {
            ::std::option::Option::Some(value) => {
                ::std::option::Option::Some(status_upcast_from_v1(value, adapters)?)
            }
            ::std::option::Option::None => ::std::option::Option::None,
        };
        Ok(DepotGetFromV1 {
            sku: sku,
            status: converted1,
        })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn upcast_depot_ship_from_v1(
        parcel: v1::Parcel,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<DepotShipFromV1> {
        let decision = adapters.depot_ship_upcast_from_v1(&parcel)?;
        let converted0 = parcel_upcast_from_v1(parcel, adapters)?;
        Ok(DepotShipFromV1 {
            parcel: converted0,
            lane: decision.lane,
        })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn carrier_rejected_downcast_to_v2(
        source: v3::CarrierRejected,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::CarrierRejected> {
        Ok(v2::CarrierRejected {
            carrier: source.carrier,
        })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn parcel_upcast_from_v2(
        source: v2::Parcel,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v3::Parcel> {
        let converted0 = sku_upcast_from_v2(source.sku, adapters)?;
        Ok(v3::Parcel {
            sku: converted0,
            code_v2: source.code_v2,
            carrier: source.carrier,
            note: source.note,
            inspect_note: ::std::option::Option::None,
        })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn parcel_downcast_to_v2(
        source: v3::Parcel,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::Parcel> {
        let converted0 = sku_downcast_to_v2(source.sku, adapters)?;
        Ok(v2::Parcel {
            sku: converted0,
            code_v2: source.code_v2,
            carrier: source.carrier,
            note: source.note,
        })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn parcel_not_found_downcast_to_v2(
        source: v3::ParcelNotFound,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::ParcelNotFound> {
        Ok(v2::ParcelNotFound {
            sku: source.sku,
        })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn sku_upcast_from_v2(
        source: v2::Sku,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v3::Sku> {
        Ok(v3::Sku { value: source.value })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn sku_downcast_to_v2(
        source: v3::Sku,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::Sku> {
        Ok(v2::Sku { value: source.value })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn status_upcast_from_v2(
        source: v2::Status,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v3::Status> {
        match source {
            v2::Status::processing => Ok(v3::Status::processing),
            v2::Status::delayed => Ok(v3::Status::delayed),
        }
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn status_downcast_to_v2(
        source: v3::Status,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::Status> {
        match source {
            v3::Status::processing => Ok(v2::Status::processing),
            v3::Status::delayed => Ok(v2::Status::delayed),
        }
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn upcast_depot_get_from_v2(
        sku: String,
        status: ::std::option::Option<v2::Status>,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<DepotGetFromV2> {
        let converted1 = match status {
            ::std::option::Option::Some(value) => {
                ::std::option::Option::Some(status_upcast_from_v2(value, adapters)?)
            }
            ::std::option::Option::None => ::std::option::Option::None,
        };
        Ok(DepotGetFromV2 {
            sku: sku,
            status: converted1,
        })
    }
    /// Projects this declaration between two adjacent API versions.
    pub fn upcast_depot_ship_from_v2(
        parcel: v2::Parcel,
        lane: String,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<DepotShipFromV2> {
        let converted0 = parcel_upcast_from_v2(parcel, adapters)?;
        Ok(DepotShipFromV2 {
            parcel: converted0,
            lane: lane,
        })
    }
    /// Projects a head error onto the older version's vocabulary.
    pub fn downcast_depot_get_error_to_v1(
        source: v2::DepotGetError,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v1::DepotGetError> {
        match source {
            v2::DepotGetError::ParcelNotFound(value) => {
                Ok(
                    v1::DepotGetError::ParcelNotFound(
                        parcel_not_found_downcast_to_v1(value, adapters)?,
                    ),
                )
            }
            v2::DepotGetError::CarrierRejected(value) => {
                adapters.depot_get_carrier_rejected_downcast_to_v1(&value)
            }
            v2::DepotGetError::Framework(value) => {
                Ok(v1::DepotGetError::Framework(value))
            }
        }
    }
    /// Projects a head error onto the older version's vocabulary.
    pub fn downcast_depot_get_error_to_v2(
        source: v3::DepotGetError,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::DepotGetError> {
        match source {
            v3::DepotGetError::ParcelNotFound(value) => {
                Ok(
                    v2::DepotGetError::ParcelNotFound(
                        parcel_not_found_downcast_to_v2(value, adapters)?,
                    ),
                )
            }
            v3::DepotGetError::CarrierRejected(value) => {
                Ok(
                    v2::DepotGetError::CarrierRejected(
                        carrier_rejected_downcast_to_v2(value, adapters)?,
                    ),
                )
            }
            v3::DepotGetError::Framework(value) => {
                Ok(v2::DepotGetError::Framework(value))
            }
        }
    }
    /// Projects a head result onto the older version.
    pub fn downcast_depot_get_result_to_v1(
        value: v2::Parcel,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v1::Parcel> {
        parcel_downcast_to_v1(value, adapters)
    }
    /// Projects a head result onto the older version.
    pub fn downcast_depot_ship_result_to_v1(
        value: v2::Status,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v1::Status> {
        status_downcast_to_v1(value, adapters)
    }
    /// Projects a head result onto the older version.
    pub fn downcast_depot_get_result_to_v2(
        value: v3::Parcel,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::Parcel> {
        parcel_downcast_to_v2(value, adapters)
    }
    /// Projects a head result onto the older version.
    pub fn downcast_depot_ship_result_to_v2(
        value: v3::Status,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::Status> {
        status_downcast_to_v2(value, adapters)
    }
}
