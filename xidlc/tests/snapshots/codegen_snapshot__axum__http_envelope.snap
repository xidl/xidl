            .map_err(|err| xidl_rust_axum::Error::new(400, format!("{err:?}")))?;
        req.headers_mut().insert(header_name, header_value);
        let auth_target = &self.client;
        let _ = auth_target;
        let resp = self
            .client
            .http()
            .execute(req)
            .await
            .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
        if resp.status().is_success() {
            Ok(())
        } else {
            let status = resp.status();
            if status.as_u16() == 412 {
                let headers = resp.headers().clone();
                let mut value: PreconditionFailed = resp
                    .json::<PreconditionFailed>()
                    .await
                    .map_err(|err| xidl_rust_axum::Error::new(
                        status.as_u16(),
                        format!("exception PreconditionFailed body: {err}"),
                    ))?;
                value.etag = match headers.get("ETag") {
                    Some(header_value) => {
                        let header_str = header_value
                            .to_str()
                            .map_err(|err| xidl_rust_axum::Error::new(
                                400,
                                format!("{err:?}"),
                            ))?;
                        header_str.to_string()
                    }
                    None => ::core::default::Default::default(),
                };
                return Err(EnvelopeApiDeleteFileError::PreconditionFailed(value));
            }
            let body = resp.json::<xidl_rust_axum::ErrorBody>().await.ok();
            Err(
                EnvelopeApiDeleteFileError::Framework(
                    xidl_rust_axum::Error::from_http_response(status, body),
                ),
            )
