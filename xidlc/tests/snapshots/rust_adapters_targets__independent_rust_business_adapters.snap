/// Pure version projections. The application owns routing and side effects.
#[allow(
    unused_imports,
    unused_variables,
    non_snake_case,
    non_camel_case_types,
    deprecated
)]
pub mod version_adapters {
    use super::{v1, v2, v3};
    /// Direction of an unsupported projection.
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum Direction {
        Upcast,
        Downcast,
    }
    /// The application renders a refusal using its own frozen error vocabulary.
    #[derive(Debug, Clone)]
    pub struct UnsupportedProjection {
        pub version: String,
        pub direction: Direction,
        pub type_path: String,
        pub reason: String,
    }
    /// A projection either succeeds or requires an unsupported business choice.
    pub type VersionedResult<T> = Result<T, UnsupportedProjection>;
    /// Explicit acknowledgement that a source value is intentionally discarded.
    #[derive(Debug, Clone, Copy)]
    pub struct Ignored {
        _private: (),
    }
    /// The acknowledgement hooks return for an intentionally retired member.
    pub const IGNORED: Ignored = Ignored { _private: () };
    /// An upcast value together with the members its handler persists.
    pub struct Upcast<T, S> {
        pub value: T,
        pub stored: S,
    }
    /// A version resolved by the application before calling an adapter.
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum Version {
        V1,
        V2,
        V3,
    }
    impl Version {
        /// Original contract identifier.
        pub fn id(self) -> &'static str {
            match self {
                Self::V1 => "v1",
                Self::V2 => "v2",
                Self::V3 => "v3",
            }
        }
        /// Original contract version value.
        pub fn value(self) -> &'static str {
            match self {
                Self::V1 => "2026-01",
                Self::V2 => "2026-04",
                Self::V3 => "2026-07",
            }
        }
    }
    /// Context for application business policy; adapters do not select versions.
    #[derive(Debug, Clone, Copy)]
    pub struct VersionContext {
        pub original_version: Version,
    }
    /// A failed response projection retains the original committed Head outcome.
    pub enum ProjectionOutcome<T, H> {
        Projected(T),
        Unsupported { head: H, error: UnsupportedProjection },
    }
    /// Invalid served-version wire data is distinct from a business refusal.
    #[derive(Debug)]
    pub enum AdaptationError {
        Validation(String),
        Unsupported(UnsupportedProjection),
    }
    impl From<UnsupportedProjection> for AdaptationError {
        fn from(value: UnsupportedProjection) -> Self {
            Self::Unsupported(value)
        }
    }
    /// Hooks remain synchronous, pure, deterministic, and mandatory.
    pub trait VersionAdapters {
        fn choice_downcast_to_v_1(
            &self,
            source: &ChoiceDowncastToV1Changes<'_>,
        ) -> VersionedResult<v1::Choice>;
        fn optional_change_upcast_from_v_1(
            &self,
            source: &v1::OptionalChange,
        ) -> VersionedResult<OptionalChangeUpcastFromV1Decision>;
        fn optional_change_downcast_to_v_1(
            &self,
            source: &v2::OptionalChange,
            stored: &dyn StoredValues,
        ) -> VersionedResult<OptionalChangeDowncastToV1Decision>;
        fn parcel_upcast_from_v_1(
            &self,
            source: &v1::Parcel,
        ) -> VersionedResult<ParcelUpcastFromV1Decision>;
        fn parcel_downcast_to_v_1(
            &self,
            source: &v2::Parcel,
            stored: &dyn StoredValues,
        ) -> VersionedResult<ParcelDowncastToV1Decision>;
        fn state_downcast_to_v_1(
            &self,
            source: &StateDowncastToV1Changes,
        ) -> VersionedResult<v1::State>;
        fn depot_get_busy_error_downcast_to_v_1(
            &self,
            source: &v2::Busy,
        ) -> VersionedResult<v1::DepotGetError>;
        fn depot_update_busy_error_downcast_to_v_1(
            &self,
            source: &v2::Busy,
        ) -> VersionedResult<v1::DepotUpdateError>;
        fn address_upcast_from_v_2(
            &self,
            source: &v2::Address,
        ) -> VersionedResult<AddressUpcastFromV2Decision>;
        fn address_downcast_to_v_2(
            &self,
            source: &v3::Address,
            stored: &dyn StoredValues,
        ) -> VersionedResult<AddressDowncastToV2Decision>;
        fn parcel_upcast_from_v_2(
            &self,
            source: &v2::Parcel,
        ) -> VersionedResult<ParcelUpcastFromV2Decision>;
        fn parcel_downcast_to_v_2(
            &self,
            source: &v3::Parcel,
            stored: &dyn StoredValues,
        ) -> VersionedResult<ParcelDowncastToV2Decision>;
        fn parcel_patch_upcast_from_v_2(
            &self,
            source: &v2::ParcelPatch,
            current: &v3::Parcel,
        ) -> VersionedResult<ParcelPatchUpcastFromV2Decision>;
        fn signed_downcast_to_v_2(
            &self,
            source: &v3::Signed,
            stored: &dyn StoredValues,
        ) -> VersionedResult<SignedDowncastToV2Decision>;
        fn state_downcast_to_v_2(
            &self,
            source: &StateDowncastToV2Changes,
        ) -> VersionedResult<v2::State>;
        fn depot_get_framework_error_downcast_to_v_2(
            &self,
            source: &v3::Framework,
        ) -> VersionedResult<v2::DepotGetError>;
        fn depot_get_denied_error_downcast_to_v_2(
            &self,
            source: &v3::Denied,
        ) -> VersionedResult<v2::DepotGetError>;
        fn depot_trace_response_downcast_to_v_2(
            &self,
            source: &String,
            stored: &dyn StoredValues,
        ) -> VersionedResult<DepotTraceResponseDowncastToV2Decision>;
        fn depot_update_framework_error_downcast_to_v_2(
            &self,
            source: &v3::Framework,
        ) -> VersionedResult<v2::DepotUpdateError>;
        fn depot_update_denied_error_downcast_to_v_2(
            &self,
            source: &v3::Denied,
        ) -> VersionedResult<v2::DepotUpdateError>;
    }
    /// Members older versions still read that Head no longer carries, resolved by the application from the source instance of the downcast step that retires them.
    pub trait StoredValues {
        /// wire `note`, last served by v1
        fn optional_change_note(&self, source: &v2::OptionalChange) -> Option<String>;
        /// wire `reference`, last served by v1
        fn parcel_legacy(&self, source: &v2::Parcel) -> Option<String>;
        /// wire `gate`, last served by v2
        fn address_gate(&self, source: &v3::Address) -> Option<String>;
        /// wire `handling_note`, last served by v2
        fn parcel_handling_note(&self, source: &v3::Parcel) -> Option<String>;
        /// wire `courier_note`, last served by v2
        fn parcel_courier_note(&self, source: &v3::Parcel) -> Option<String>;
        /// wire `tag`, last served by v2
        fn signed_tag(&self, source: &v3::Signed) -> Option<String>;
        /// wire `trace_id`, last served by v2
        fn depot_trace_response_trace_id(&self, source: &String) -> Option<String>;
    }
    /// Wire names one served version still reads from storage.
    pub type VersionNeeds = (&'static str, &'static [&'static str]);
    /// Storage wire names served by one version of one declared type.
    pub type StoredNeedsEntry = (&'static str, &'static [VersionNeeds]);
    /// Wire names each served version still reads from storage, by type; Head reads nothing.
    pub const NEEDS: &[StoredNeedsEntry] = &[
        ("Address", &[("2026-07", &[]), ("2026-04", &["gate"]), ("2026-01", &["gate"])]),
        (
            "Depot.trace",
            &[("2026-07", &[]), ("2026-04", &["trace_id"]), ("2026-01", &["trace_id"])],
        ),
        (
            "OptionalChange",
            &[("2026-07", &[]), ("2026-04", &[]), ("2026-01", &["note"])],
        ),
        (
            "Parcel",
            &[
                ("2026-07", &[]),
                ("2026-04", &["courier_note", "handling_note"]),
                ("2026-01", &["courier_note", "handling_note", "reference"]),
            ],
        ),
        ("Signed", &[("2026-07", &[]), ("2026-04", &["tag"]), ("2026-01", &["tag"])]),
    ];
    /// A Head outcome together with the stored values its downcast still reads.
    pub struct HeadOutcome<T, E, S> {
        pub outcome: Result<T, E>,
        pub stored: S,
    }
