    fn locate<T>(result: VersionedResult<T>, path: &str) -> VersionedResult<T> {
        result
            .map_err(|error| UnsupportedProjection {
                type_path: format!("{path}.{}", error.type_path),
                ..error
            })
    }
    fn map_sequence<S, T, C>(
        source: &[S],
        convert: impl Fn(&S) -> VersionedResult<T>,
        refusal: impl Fn(&str) -> UnsupportedProjection,
        path: &str,
    ) -> VersionedResult<C>
    where
        C: TryFrom<Vec<T>>,
        C::Error: ::std::fmt::Display,
    {
        let values = source
            .iter()
            .map(|item| locate(convert(item), path))
            .collect::<VersionedResult<Vec<_>>>()?;
        C::try_from(values).map_err(|error| refusal(&error.to_string()))
    }
    fn map_array<S, T, const N: usize>(
        source: &[S; N],
        convert: impl Fn(&S) -> VersionedResult<T>,
        refusal: impl Fn(&str) -> UnsupportedProjection,
        path: &str,
    ) -> VersionedResult<[T; N]> {
        let values = source
            .iter()
            .map(|item| locate(convert(item), path))
            .collect::<VersionedResult<Vec<_>>>()?;
        values
            .try_into()
            .map_err(|_: Vec<T>| refusal("array projection changed its length"))
    }
    fn map_record<K: Ord, V, L: Ord, W, C>(
        source: &::std::collections::BTreeMap<K, V>,
        key: impl Fn(&K) -> VersionedResult<L>,
        value: impl Fn(&V) -> VersionedResult<W>,
        refusal: impl Fn(&str) -> UnsupportedProjection,
        path: &str,
    ) -> VersionedResult<C>
    where
        C: TryFrom<::std::collections::BTreeMap<L, W>>,
        C::Error: ::std::fmt::Display,
    {
        let mut target = ::std::collections::BTreeMap::new();
        for (old_key, old_value) in source {
            let next_key = locate(key(old_key), path)?;
            let next_value = locate(value(old_value), path)?;
            if target.insert(next_key, next_value).is_some() {
                return Err(refusal("map key projection is not injective"));
            }
        }
        C::try_from(target).map_err(|error| refusal(&error.to_string()))
    }
    /// Projects one adjacent declaration by borrowing its source value.
    pub fn address_upcast_from_v_1(
        source: &v1::Address,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::Address> {
        let refusal = |reason: &str| UnsupportedProjection {
            version: "v1".into(),
            direction: Direction::Upcast,
            type_path: "Address".into(),
            reason: reason.into(),
        };
        let projected_0 = Ok::<
            _,
            UnsupportedProjection,
        >(::std::clone::Clone::clone(&source.zip))?;
        let projected_1 = ::std::option::Option::as_ref(&source.gate)
            .map(|item| Ok::<_, UnsupportedProjection>(::std::clone::Clone::clone(item)))
            .transpose()?;
        Ok(v2::Address {
            zip: projected_0,
            gate: projected_1,
        })
    }
    /// Projects one adjacent declaration by borrowing its source value.
    pub fn address_downcast_to_v_1(
        source: &v2::Address,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v1::Address> {
        let refusal = |reason: &str| UnsupportedProjection {
            version: "v2".into(),
            direction: Direction::Downcast,
            type_path: "Address".into(),
            reason: reason.into(),
        };
        let projected_0 = Ok::<
            _,
            UnsupportedProjection,
        >(::std::clone::Clone::clone(&source.zip))?;
        let projected_1 = ::std::option::Option::as_ref(&source.gate)
            .map(|item| Ok::<_, UnsupportedProjection>(::std::clone::Clone::clone(item)))
            .transpose()?;
        Ok(v1::Address {
            zip: projected_0,
            gate: projected_1,
        })
    }
    /// Projects one adjacent declaration by borrowing its source value.
    pub fn ambiguous_representation_upcast_from_v_1(
        source: &v1::AmbiguousRepresentation,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::AmbiguousRepresentation> {
        let refusal = |reason: &str| UnsupportedProjection {
            version: "v1".into(),
            direction: Direction::Upcast,
            type_path: "AmbiguousRepresentation".into(),
            reason: reason.into(),
        };
        match source {
            v1::AmbiguousRepresentation::Json(item) => {
                short_payload_upcast_from_v_1(item, adapters)
                    .map(v2::AmbiguousRepresentation::Json)
            }
            v1::AmbiguousRepresentation::Text(item) => {
                short_payload_upcast_from_v_1(item, adapters)
                    .map(v2::AmbiguousRepresentation::Text)
            }
        }
    }
    /// Projects one adjacent declaration by borrowing its source value.
    pub fn ambiguous_representation_downcast_to_v_1(
        source: &v2::AmbiguousRepresentation,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v1::AmbiguousRepresentation> {
        let refusal = |reason: &str| UnsupportedProjection {
            version: "v2".into(),
            direction: Direction::Downcast,
            type_path: "AmbiguousRepresentation".into(),
            reason: reason.into(),
        };
        match source {
            v2::AmbiguousRepresentation::Json(item) => {
                short_payload_downcast_to_v_1(item, adapters)
                    .map(v1::AmbiguousRepresentation::Json)
            }
            v2::AmbiguousRepresentation::Text(item) => {
                short_payload_downcast_to_v_1(item, adapters)
                    .map(v1::AmbiguousRepresentation::Text)
            }
        }
    }
    /// Projects one adjacent declaration by borrowing its source value.
    pub fn cannot_represent_downcast_to_v_1(
        source: &v2::CannotRepresent,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v1::CannotRepresent> {
        let refusal = |reason: &str| UnsupportedProjection {
            version: "v2".into(),
            direction: Direction::Downcast,
            type_path: "CannotRepresent".into(),
            reason: reason.into(),
        };
        let projected_0 = Ok::<
            _,
            UnsupportedProjection,
        >(::std::clone::Clone::clone(&source.reason))?;
        Ok(v1::CannotRepresent {
            reason: projected_0,
        })
    }
    /// Projects one adjacent declaration by borrowing its source value.
    pub fn choice_upcast_from_v_1(
        source: &v1::Choice,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v2::Choice> {
        let refusal = |reason: &str| UnsupportedProjection {
            version: "v1".into(),
            direction: Direction::Upcast,
            type_path: "Choice".into(),
            reason: reason.into(),
        };
        if source.is_text() {
            return Ok::<
