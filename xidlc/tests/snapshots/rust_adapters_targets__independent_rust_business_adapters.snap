    /// Members the update handler persists for this request chain.
    #[derive(Debug, Clone, Default)]
    pub struct DepotUpdateStored {
        pub handling_note: Option<String>,
    }
    impl DepotUpdateStored {
        /// Combine the persisted members collected along the request chain.
        pub fn merge(self, other: Self) -> Self {
            Self {
                handling_note: self.handling_note.or(other.handling_note),
            }
        }
    }
