/** Hooks are required application decisions. Keep them pure and deterministic. */
export interface VersionAdapters {
    
        choiceDowncastToV1(source: { count: number }): VersionedResult<types.v1.Choice>;
    
        optionalChangeUpcastFromV1(source: types.v1.OptionalChange): VersionedResult<OptionalChangeUpcastDecisionFromV1>;
    
        optionalChangeDowncastToV1(source: types.v2.OptionalChange, stored: Pick<StoredValues, "optionalChangeNote">): VersionedResult<OptionalChangeDowncastDecisionToV1>;
    
        parcelUpcastFromV1(source: types.v1.Parcel): VersionedResult<ParcelUpcastDecisionFromV1>;
    
        parcelDowncastToV1(source: types.v2.Parcel, stored: Pick<StoredValues, "parcelLegacy">): VersionedResult<ParcelDowncastDecisionToV1>;
    
        stateDowncastToV1(source: "shipping"): VersionedResult<types.v1.State>;
    
        depotGetBusyErrorDowncastToV1(source: errors.v2$Busy): VersionedResult<errors.v1$NotFound | FrameworkError>;
    
        depotUpdateBusyErrorDowncastToV1(source: errors.v2$Busy): VersionedResult<errors.v1$NotFound | FrameworkError>;
    
        parcelUpcastFromV2(source: types.v2.Parcel): VersionedResult<ParcelUpcastDecisionFromV2>;
    
        parcelDowncastToV2(source: types.v3.Parcel, stored: Pick<StoredValues, "parcelHandlingNote">): VersionedResult<ParcelDowncastDecisionToV2>;
    
        parcelPatchUpcastFromV2(source: types.v2.ParcelPatch, current: types.v3.Parcel): VersionedResult<ParcelPatchUpcastDecisionFromV2>;
    
        stateDowncastToV2(source: "delivered"): VersionedResult<types.v2.State>;
    
        depotGetFrameworkErrorDowncastToV2(source: errors.Framework): VersionedResult<errors.v2$NotFound | errors.v2$Busy | FrameworkError>;
    
        depotGetDeniedErrorDowncastToV2(source: errors.Denied): VersionedResult<errors.v2$NotFound | errors.v2$Busy | FrameworkError>;
    
        depotTraceResponseDowncastToV2(source: { "return": string }, stored: Pick<StoredValues, "depotTraceResponseTraceId">): VersionedResult<DepotTraceResponseDowncastDecisionToV2>;
    
        depotUpdateFrameworkErrorDowncastToV2(source: errors.Framework): VersionedResult<errors.v2$NotFound | errors.v2$Busy | FrameworkError>;
    
        depotUpdateDeniedErrorDowncastToV2(source: errors.Denied): VersionedResult<errors.v2$NotFound | errors.v2$Busy | FrameworkError>;
    
}

    /** Members older versions still read that Head no longer carries, resolved per Head instance by the application. */
    export interface StoredValues {
        
            /** wire `note`, last served by v1 */
            optionalChangeNote(source: types.v2.OptionalChange): string | undefined;
        
            /** wire `reference`, last served by v1 */
            parcelLegacy(source: types.v2.Parcel): string | undefined;
        
            /** wire `handling_note`, last served by v2 */
            parcelHandlingNote(source: types.v3.Parcel): string | undefined;
        
            /** wire `trace_id`, last served by v2 */
            depotTraceResponseTraceId(source: { "return": string }): string | undefined;
        
    }
    /** Wire names each served version still reads from storage, by type; Head reads nothing. */
    export const NEEDS = {
        
            "Depot.trace": { "2026-07": [], "2026-04": ["trace_id"], "2026-01": ["trace_id"] },
        
            "OptionalChange": { "2026-07": [], "2026-04": [], "2026-01": ["note"] },
        
            "Parcel": { "2026-07": [], "2026-04": ["handling_note"], "2026-01": ["handling_note", "reference"] },
        
    } as const;


    export interface OptionalChangeUpcastDecisionFromV1 {
        
            note?: string;
        
            "ignored$note": Ignored;
        
    }

    export interface OptionalChangeDowncastDecisionToV1 {
        
            note: string | Omitted;
        
    }

    export interface ParcelUpcastDecisionFromV1 {
        
            tracking: string;
        
            carrier: string;
        
            note?: string;
        
            courier_note?: string;
        
            legacy: Ignored;
        
    }

    export interface ParcelDowncastDecisionToV1 {
        
            legacy: string;
        
    }

    export interface ParcelUpcastDecisionFromV2 {
        
            inspected?: string;
        
            audit: string;
        
            handling_note: Ignored;
        
    }

    export interface ParcelDowncastDecisionToV2 {
        
            handling_note: string | Omitted;
        
    }

    export interface ParcelPatchUpcastDecisionFromV2 {
        
            handling_note: Ignored;
        
            stored: DepotUpdateStored;
        
    }

    export interface DepotTraceResponseDowncastDecisionToV2 {
        
            trace_id: string;
        
    }


    /** Members the update handler persists for this request chain. */
    export interface DepotUpdateStored {
        
            handling_note?: string;
        
    }





