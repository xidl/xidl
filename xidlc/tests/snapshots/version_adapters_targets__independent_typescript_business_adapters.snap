    export function upcastParcelFromV2(source: types.v2.Parcel, adapters: VersionAdapters): VersionedResult<types.v3.Parcel> {
        
            
                const decision = adapters.parcelUpcastFromV2(source);
                if (!decision.ok) return decision;
            
            
                const converted0 = ok(source["id"]);
                if (!converted0.ok) return converted0;
            
                const converted1 = ok(source["tracking"]);
                if (!converted1.ok) return converted1;
            
                const converted2 = ok(source["carrier"]);
                if (!converted2.ok) return converted2;
            
                const converted3 = mapOptional(source["note"], (item) => ok(item));
                if (!converted3.ok) return converted3;
            
                const converted4 = mapOptional(source["courier_note"], (item) => ok(item));
                if (!converted4.ok) return converted4;
            
                const converted5 = upcastAddressFromV2(source["address"], adapters);
                if (!converted5.ok) return converted5;
            
                const converted6 = mapSequence(source["stops"], (item) => upcastAddressFromV2(item, adapters));
                if (!converted6.ok) return converted6;
            
                const converted7 = mapRecord(source["by_tag"], (item) => upcastAddressFromV2(item, adapters));
                if (!converted7.ok) return converted7;
            
                const converted8 = mapSequence(source["fixed"], (item) => upcastAddressFromV2(item, adapters));
                if (!converted8.ok) return converted8;
            
            return ok({
                
                        ["id"]: converted0.value,
                        ["tracking"]: converted1.value,
                        ["carrier"]: converted2.value,
                        ...(converted3.value === undefined ? {} : { ["note"]: converted3.value }),
                        ...(converted4.value === undefined ? {} : { ["courier_remark"]: converted4.value }),
                        ["address"]: converted5.value,
                        ["stops"]: converted6.value,
                        ["by_tag"]: converted7.value,
                        ["fixed"]: converted8.value,
                
                        ...(decision.value["inspected"] === undefined ? {} : { ["inspected"]: decision.value["inspected"] }),
                        ["audit"]: decision.value["audit"],
            });
        
    }

    export function downcastParcelToV2(source: types.v3.Parcel, stored: StoredValues, adapters: VersionAdapters): VersionedResult<types.v2.Parcel> {
        
            
                const decision = adapters.parcelDowncastToV2(source, stored);
                if (!decision.ok) return decision;
            
            
                const converted0 = ok(source["id"]);
                if (!converted0.ok) return converted0;
            
                const converted1 = ok(source["tracking"]);
                if (!converted1.ok) return converted1;
            
                const converted2 = ok(source["carrier"]);
                if (!converted2.ok) return converted2;
            
                const converted3 = mapOptional(source["note"], (item) => ok(item));
                if (!converted3.ok) return converted3;
            
                const converted4 = mapOptional(source["courier_remark"], (item) => ok(item));
                if (!converted4.ok) return converted4;
            
                const converted5 = downcastAddressToV2(source["address"], adapters);
                if (!converted5.ok) return converted5;
            
                const converted6 = mapSequence(source["stops"], (item) => downcastAddressToV2(item, adapters));
                if (!converted6.ok) return converted6;
            
                const converted7 = mapRecord(source["by_tag"], (item) => downcastAddressToV2(item, adapters));
                if (!converted7.ok) return converted7;
            
                const converted8 = mapSequence(source["fixed"], (item) => downcastAddressToV2(item, adapters));
                if (!converted8.ok) return converted8;
            
            return ok({
                
                        ["id"]: converted0.value,
                        ["tracking"]: converted1.value,
                        ["carrier"]: converted2.value,
                        ...(converted3.value === undefined ? {} : { ["note"]: converted3.value }),
                        ...(converted4.value === undefined ? {} : { ["courier_note"]: converted4.value }),
                        ["address"]: converted5.value,
                        ["stops"]: converted6.value,
                        ["by_tag"]: converted7.value,
                        ["fixed"]: converted8.value,
                
                        ...(decision.value["handling_note"] === OMIT ? {} : { ["handling_note"]: decision.value["handling_note"] }),
            });
        
    }

    export function upcastParcelPatchFromV2(source: types.v2.ParcelPatch, current: types.v3.Parcel, adapters: VersionAdapters): VersionedResult<UpcastValue<types.v3.ParcelPatch, DepotUpdateStored>> {
        
            
                const decision = adapters.parcelPatchUpcastFromV2(source, current);
                if (!decision.ok) return decision;
            
            
                const converted0 = mapOptional(source["note"], (item) => ok(item));
                if (!converted0.ok) return converted0;
            
                return ok({
                    value: {
                        
                            
                            
                                ...(converted0.value === undefined ? {} : { ["note"]: converted0.value }),
                            
                        
                        
                    },
                    stored: {
                        
                            
                        
                        
                            ...decision.value.stored,
                        
                    },
                });
        
    }

    export function upcastStateFromV2(source: types.v2.State, adapters: VersionAdapters): VersionedResult<types.v3.State> {
        
            switch (source) {
                
                    case "pending": return ok(source);
                
                    case "shipping": return ok(source);
                
                
                    default: { const exhaustive: never = source; return ok(exhaustive); }
                
            }
        
