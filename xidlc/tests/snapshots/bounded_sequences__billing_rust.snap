                "values".as_bytes(),
            )
            .map_err(|err| xidl_rust_axum::Error::new(400, format!("{err:?}")))?;
        for value in values {
            let header_value_str = value.to_string();
            if header_value_str.contains(',')
                || header_value_str.trim() != header_value_str
            {
                return Err(
                    xidl_rust_axum::Error::new(
                            400,
                            concat!(
