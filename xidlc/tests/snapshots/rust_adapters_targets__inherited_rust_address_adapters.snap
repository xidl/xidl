        let refusal = |reason: &str| UnsupportedProjection {
            version: "v1".into(),
            direction: Direction::Upcast,
            type_path: "DeliveryReference".into(),
            reason: reason.into(),
        };
        Ok::<_, UnsupportedProjection>(::std::clone::Clone::clone(source))
    }
