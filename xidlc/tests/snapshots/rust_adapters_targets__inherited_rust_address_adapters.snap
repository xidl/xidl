    fn locate<T>(result: VersionedResult<T>, path: &str) -> VersionedResult<T> {
        result
            .map_err(|error| UnsupportedProjection {
                type_path: format!("{path}.{}", error.type_path),
                ..error
            })
    }
    fn map_sequence<S, T>(
        source: &[S],
        convert: impl Fn(&S) -> VersionedResult<T>,
        path: &str,
    ) -> VersionedResult<Vec<T>> {
        source.iter().map(|item| locate(convert(item), path)).collect()
    }
    fn map_array<S, T, const N: usize>(
        source: &[S; N],
        convert: impl Fn(&S) -> VersionedResult<T>,
        refusal: impl Fn(&str) -> UnsupportedProjection,
        path: &str,
    ) -> VersionedResult<[T; N]> {
        let values = source
            .iter()
            .map(|item| locate(convert(item), path))
            .collect::<VersionedResult<Vec<_>>>()?;
        values
            .try_into()
            .map_err(|_: Vec<T>| refusal("array projection changed its length"))
    }
    /// Projects one adjacent declaration by borrowing its source value.
    pub fn delivery_reference_upcast_from_v_1(
