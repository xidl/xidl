/// Pure version projections. The application owns routing and side effects.
#[allow(
    unused_imports,
    unused_variables,
    non_snake_case,
    non_camel_case_types,
    deprecated
)]
pub mod version_adapters {
    use super::{v1, v2, v3};
    /// Direction of an unsupported projection.
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum Direction {
        Upcast,
        Downcast,
    }
    /// The application renders a refusal using its own frozen error vocabulary.
    #[derive(Debug, Clone)]
    pub struct UnsupportedProjection {
        pub version: String,
        pub direction: Direction,
        pub type_path: String,
        pub reason: String,
    }
    /// A projection either succeeds or requires an unsupported business choice.
    pub type VersionedResult<T> = Result<T, UnsupportedProjection>;
    /// Explicit acknowledgement that a source value is intentionally discarded.
    #[derive(Debug, Clone, Copy)]
    pub struct Ignored {
        _private: (),
    }
    /// The acknowledgement hooks return for an intentionally retired member.
    pub const IGNORED: Ignored = Ignored { _private: () };
    /// An upcast value together with the members its handler persists.
    pub struct Upcast<T, S> {
        pub value: T,
        pub stored: S,
    }
    /// A version resolved by the application before calling an adapter.
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum Version {
        V1,
        V2,
        V3,
    }
    impl Version {
        /// Original contract identifier.
        pub fn id(self) -> &'static str {
            match self {
                Self::V1 => "v1",
                Self::V2 => "v2",
                Self::V3 => "v3",
            }
        }
        /// Original contract version value.
        pub fn value(self) -> &'static str {
            match self {
                Self::V1 => "2026-01-01",
                Self::V2 => "2026-04-01",
                Self::V3 => "2026-07-01",
            }
        }
    }
    /// Context for application business policy; adapters do not select versions.
    #[derive(Debug, Clone, Copy)]
    pub struct VersionContext {
        pub original_version: Version,
    }
    /// A failed response projection retains the original committed Head outcome.
    pub enum ProjectionOutcome<T, H> {
        Projected(T),
        Unsupported { head: H, error: UnsupportedProjection },
    }
    /// Invalid served-version wire data is distinct from a business refusal.
    #[derive(Debug)]
    pub enum AdaptationError {
        Validation(String),
        Unsupported(UnsupportedProjection),
    }
    impl From<UnsupportedProjection> for AdaptationError {
        fn from(value: UnsupportedProjection) -> Self {
            Self::Unsupported(value)
        }
    }
