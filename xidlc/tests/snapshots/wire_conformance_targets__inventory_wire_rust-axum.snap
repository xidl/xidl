        let resp = self
            .client
            .http()
            .execute(req)
            .await
            .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
        if resp.status().is_success() {
            let headers = resp.headers().clone();
            let count_reply: i32 = match headers.get("X-Count") {
                Some(header_value) => {
                    let header_str = header_value
                        .to_str()
                        .map_err(|err| xidl_rust_axum::Error::new(
                            400,
                            format!("{err:?}"),
                        ))?;
                    header_str
                        .parse()
                        .map_err(|err| xidl_rust_axum::Error::new(
                            400,
                            format!("{err:?}"),
                        ))?
                }
                None => ::core::default::Default::default(),
            };
            let count_reply: i32 = count_reply;
            let cookie_map = xidl_rust_axum::http::parse_set_cookies(
                headers.get_all(::xidl_rust_axum::reqwest::header::SET_COOKIE).iter(),
            );
            let receipt: String = match cookie_map
                .get("receipt")
                .and_then(|values| values.first())
            {
                Some(value) => value.to_string(),
                None => ::core::default::Default::default(),
            };
            let receipt: String = receipt;
            let body = resp
                .bytes()
                .await
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            let body: StoreBindingsResponseInBody = xidl_rust_axum::DeserializeFactory::new(
                    "text/plain",
                )
                .from_slice(&body)?;
            let mut response: StoreBindingsResponse = body.into();
            response.count_reply = count_reply;
            response.receipt = receipt;
            Ok(response)
        } else {
            let status = resp.status();
            let body = resp.json::<xidl_rust_axum::ErrorBody>().await.ok();
            Err(xidl_rust_axum::Error::from_http_response(status, body))
        }
    }
    #[allow(clippy::useless_conversion, unused_mut, unreachable_code, unused_variables)]
    pub async fn feed(
        &self,
        state: String,
    ) -> Result<
        xidl_rust_axum::stream::Reader<catalog::Change, StoreFeedError>,
        StoreFeedError,
    > {
        let xidl_path = "/feed/{state}".to_string();
        let xidl_path = xidl_path.replace("{state}", &state.to_string());
        let mut req = self
            .client
            .http()
            .request(xidl_rust_axum::reqwest::Method::GET, self.client.url(&xidl_path))
            .build()
            .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
        req.headers_mut()
            .insert(
                xidl_rust_axum::reqwest::header::ACCEPT,
                xidl_rust_axum::reqwest::header::HeaderValue::from_str(
                        "text/event-stream",
                    )
                    .map_err(|err| xidl_rust_axum::Error::new(400, format!("{err:?}")))?,
            );
        let auth_target = &self.client;
        let _ = auth_target;
        xidl_rust_axum::stream::open_sse::<
            catalog::Change,
            StoreFeedError,
        >(self.client.http(), req)
            .await
    }
}
