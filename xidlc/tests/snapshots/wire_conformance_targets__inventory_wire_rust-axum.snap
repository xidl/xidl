    pub async fn bindings(
        &self,
        count: i32,
        initial: char,
        session: String,
    ) -> Result<StoreBindingsResponse, xidl_rust_axum::Error> {
        let initial: char = initial;
        let session: String = session;
        let xidl_path = "/bindings".to_string();
        let mut req = self
            .client
            .http()
            .request(xidl_rust_axum::reqwest::Method::GET, self.client.url(&xidl_path))
            .build()
            .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
        req.headers_mut()
            .insert(
                xidl_rust_axum::reqwest::header::ACCEPT,
                xidl_rust_axum::reqwest::header::HeaderValue::from_str("text/plain")
                    .map_err(|err| xidl_rust_axum::Error::new(400, format!("{err:?}")))?,
            );
        let header_name = xidl_rust_axum::reqwest::header::HeaderName::from_bytes(
                "X-Initial".as_bytes(),
            )
            .map_err(|err| xidl_rust_axum::Error::new(400, format!("{err:?}")))?;
        let header_value_str = initial.to_string();
        let header_value = xidl_rust_axum::reqwest::header::HeaderValue::from_str(
                &header_value_str,
            )
            .map_err(|err| xidl_rust_axum::Error::new(400, format!("{err:?}")))?;
        req.headers_mut().insert(header_name, header_value);
        let mut cookie_pairs: Vec<String> = Vec::new();
        let value_str = session;
        cookie_pairs
            .push(
                xidl_rust_axum::cookie::Cookie::new("session", value_str)
                    .encoded()
                    .to_string(),
            );
        if !cookie_pairs.is_empty() {
            let cookie_value = cookie_pairs.join("; ");
            let cookie_name = xidl_rust_axum::reqwest::header::HeaderName::from_static(
                "cookie",
            );
            let merged = match req.headers().get(&cookie_name) {
                Some(existing) => {
                    let existing = existing
                        .to_str()
                        .map_err(|err| xidl_rust_axum::Error::new(
                            400,
                            format!("{err:?}"),
                        ))?;
                    if existing.is_empty() {
                        cookie_value
                    } else {
                        format!("{existing}; {cookie_value}")
                    }
                }
                None => cookie_value,
            };
            let header_value = xidl_rust_axum::reqwest::header::HeaderValue::from_str(
                    &merged,
                )
                .map_err(|err| xidl_rust_axum::Error::new(400, format!("{err:?}")))?;
            req.headers_mut().insert(cookie_name, header_value);
        }
