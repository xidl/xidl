            .client
            .http()
            .request(xidl_rust_axum::reqwest::Method::POST, self.client.url(&xidl_path))
            .build()
            .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
        req.headers_mut()
            .insert(
                xidl_rust_axum::reqwest::header::ACCEPT,
                xidl_rust_axum::reqwest::header::HeaderValue::from_str(
                        "application/json",
                    )
                    .map_err(|err| xidl_rust_axum::Error::new(400, format!("{err:?}")))?,
            );
        let auth_target = &self.client;
        let _ = auth_target;
        req.headers_mut()
            .insert(
                xidl_rust_axum::reqwest::header::CONTENT_TYPE,
                xidl_rust_axum::reqwest::header::HeaderValue::from_static(
                    "application/x-ndjson",
                ),
            );
        let (tx, rx) = xidl_rust_axum::tokio::sync::mpsc::channel(32);
        let outbound = xidl_rust_axum::futures_util::stream::unfold(
            rx,
            |mut rx| async move { rx.recv().await.map(|item| (item, rx)) },
        );
        *req.body_mut() = Some(
            xidl_rust_axum::stream::encode_ndjson_body(Box::pin(outbound)),
        );
        let http = self.client.http().clone();
        let response_task = xidl_rust_axum::tokio::spawn(async move {
            let resp = http
                .execute(req)
                .await
                .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
            if resp.status().is_success() {
                let body = resp
                    .bytes()
                    .await
                    .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
                let body: __xidl_in_Ledger::ImportResult = xidl_rust_axum::DeserializeFactory::new(
                        "application/json",
                    )
                    .from_slice(&body)?;
                Ok(body.into())
            } else {
                let status = resp.status().as_u16();
                let bytes = resp
                    .bytes()
                    .await
                    .map_err(|error| xidl_rust_axum::Error::message(
                        format!("stream HTTP error body: {error}"),
                    ))?;
                let body = xidl_rust_axum::serde_json::from_slice(&bytes)
                    .unwrap_or_else(|_| xidl_rust_axum::serde_json::Value::String(
                        String::from_utf8_lossy(&bytes).into_owned(),
                    ));
                Err(
                    <LedgerImportRowsError as xidl_rust_axum::stream::StreamException>::from_failure(xidl_rust_axum::stream::StreamFailure {
                        status,
                        body,
                    })?,
                )
            }
        });
        Ok(xidl_rust_axum::stream::Writer::new(tx, response_task))
    }
}
