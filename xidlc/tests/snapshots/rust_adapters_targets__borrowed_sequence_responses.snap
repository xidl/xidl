    /// Public model parameters for one served version's operation.
    pub struct ResponsesRetiredHeaderRequestV2 {}
    fn locate<T>(result: VersionedResult<T>, path: &str) -> VersionedResult<T> {
        result
            .map_err(|error| UnsupportedProjection {
                type_path: format!("{path}.{}", error.type_path),
                ..error
            })
    }
    fn map_sequence<S, T, C>(
        source: &[S],
        convert: impl Fn(&S) -> VersionedResult<T>,
        refusal: impl Fn(&str) -> UnsupportedProjection,
        path: &str,
    ) -> VersionedResult<C>
    where
        C: TryFrom<Vec<T>>,
        C::Error: ::std::fmt::Display,
    {
        let values = source
            .iter()
            .map(|item| locate(convert(item), path))
            .collect::<VersionedResult<Vec<_>>>()?;
        C::try_from(values).map_err(|error| refusal(&error.to_string()))
    }
    /// Projects one adjacent declaration by borrowing its source value.
    pub fn item_downcast_to_v_1(
        source: &v2::Item,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v1::Item> {
        let refusal = |reason: &str| UnsupportedProjection {
            version: "v2".into(),
            direction: Direction::Downcast,
            type_path: "Item".into(),
            reason: reason.into(),
        };
        let projected_0 = Ok::<
            _,
            UnsupportedProjection,
        >(::std::clone::Clone::clone(&source.id))?;
        Ok(v1::Item { id: projected_0 })
    }
    /// Projects one adjacent declaration by borrowing its source value.
    pub fn items_downcast_to_v_1(
        source: &v2::Items,
        adapters: &dyn VersionAdapters,
    ) -> VersionedResult<v1::Items> {
        let refusal = |reason: &str| UnsupportedProjection {
            version: "v2".into(),
            direction: Direction::Downcast,
            type_path: "Items".into(),
            reason: reason.into(),
        };
        map_sequence(
            source,
            |item| item_downcast_to_v_1(item, adapters),
            refusal,
            "Items",
        )
    }
