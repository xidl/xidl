/// Pure version projections. The application owns routing and side effects.
#[allow(
    unused_imports,
    unused_variables,
    non_snake_case,
    non_camel_case_types,
    deprecated
)]
pub mod version_adapters {
    use super::{v1, v2};
    /// Direction of an unsupported projection.
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum Direction {
        Upcast,
        Downcast,
    }
    /// The application renders a refusal using its own frozen error vocabulary.
    #[derive(Debug, Clone)]
    pub struct UnsupportedProjection {
        pub version: String,
        pub direction: Direction,
        pub type_path: String,
        pub reason: String,
    }
    /// A projection either succeeds or requires an unsupported business choice.
    pub type VersionedResult<T> = Result<T, UnsupportedProjection>;
    /// Explicit acknowledgement that a source value is intentionally discarded.
    #[derive(Debug, Clone, Copy)]
    pub struct Ignored {
        _private: (),
    }
    /// The acknowledgement hooks return for an intentionally retired member.
    pub const IGNORED: Ignored = Ignored { _private: () };
    /// A version resolved by the application before calling an adapter.
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum Version {
        V1,
        V2,
    }
    impl Version {
        /// Original contract identifier.
        pub fn id(self) -> &'static str {
            match self {
                Self::V1 => "v1",
                Self::V2 => "v2",
            }
        }
        /// Original contract version value.
        pub fn value(self) -> &'static str {
            match self {
                Self::V1 => "v1",
                Self::V2 => "v2",
            }
        }
    }
    /// Context for application business policy; adapters do not select versions.
    #[derive(Debug, Clone, Copy)]
    pub struct VersionContext {
        pub original_version: Version,
    }
    /// A failed response projection retains the original committed Head outcome.
    pub enum ProjectionOutcome<T, H> {
        Projected(T),
        Unsupported { head: H, error: UnsupportedProjection },
    }
    /// Invalid served-version wire data is distinct from a business refusal.
    #[derive(Debug)]
    pub enum AdaptationError {
        Validation(String),
        Unsupported(UnsupportedProjection),
    }
    impl From<UnsupportedProjection> for AdaptationError {
        fn from(value: UnsupportedProjection) -> Self {
            Self::Unsupported(value)
        }
    }
    /// Hooks remain synchronous, pure, deterministic, and mandatory.
    pub trait VersionAdapters {
        fn responses_retired_header_response_downcast_to_v_1(
            &self,
            source: &[v2::Item],
            stored: &dyn StoredValues,
        ) -> VersionedResult<ResponsesRetiredHeaderResponseDowncastToV1Decision>;
    }
    /// Members older versions still read that Head no longer carries, resolved by the application from the source instance of the downcast step that retires them.
    pub trait StoredValues {
        /// wire `receipt`, last served by v1
        fn responses_retired_header_response_receipt(
            &self,
            source: &[v2::Item],
        ) -> Option<String>;
    }
    /// Wire names one served version still reads from storage.
    pub type VersionNeeds = (&'static str, &'static [&'static str]);
    /// Storage wire names served by one version of one declared type.
    pub type StoredNeedsEntry = (&'static str, &'static [VersionNeeds]);
    /// Wire names each served version still reads from storage, by type; Head reads nothing.
    pub const NEEDS: &[StoredNeedsEntry] = &[
        ("Responses.retired_header", &[("v2", &[]), ("v1", &["receipt"])]),
    ];
    /// A Head outcome together with the stored values its downcast still reads.
    pub struct HeadOutcome<T, E, S> {
        pub outcome: Result<T, E>,
        pub stored: S,
    }
    /// Explicit business assignments and discarded-value acknowledgements.
    pub struct ResponsesRetiredHeaderResponseDowncastToV1Decision {
        pub receipt: String,
    }
    /// Public model parameters for one served version's operation.
    pub struct ResponsesAliasRequestV1 {}
    /// Public model parameters for one served version's operation.
    pub struct ResponsesBytesRequestV1 {}
