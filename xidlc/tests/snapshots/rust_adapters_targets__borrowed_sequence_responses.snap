    /// The complete typed result of this operation in one frozen contract.
    pub type ResponsesAliasResultV1 = Result<v1::Items, ::xidl_rust_axum::Error>;
    /// Validate the served request before executing any business conversion.
    pub fn decode_and_upcast_responses_alias_from_v_1(
        wire: ::serde_json::Value,
        adapters: &dyn VersionAdapters,
    ) -> Result<ResponsesAliasRequestV2, AdaptationError> {
        let object = wire
            .as_object()
            .ok_or_else(|| AdaptationError::Validation(
                "request parameter envelope must be an object".into(),
            ))?;
        let keys: &[&str] = &[];
        if let Some(key) = object.keys().find(|key| !keys.contains(&key.as_str())) {
            return Err(
                AdaptationError::Validation(format!("unknown source parameter {key}")),
            );
        }
        let source = ResponsesAliasRequestV1 {};
        let source = responses_alias_request_upcast_from_v_1(&source, adapters)?;
        Ok(source)
    }
    /// Project an owned Head result and retain it unchanged on any refusal.
    pub fn downcast_responses_alias_from_v_1_outcome(
        head: ResponsesAliasResultV2,
        adapters: &dyn VersionAdapters,
    ) -> ProjectionOutcome<ResponsesAliasResultV1, ResponsesAliasResultV2> {
        match &head {
            Ok(source) => {
                let source = match responses_alias_response_downcast_to_v_1(
                    source,
                    adapters,
                ) {
                    Ok(value) => value,
                    Err(error) => {
                        return ProjectionOutcome::Unsupported {
                            head,
                            error,
                        };
                    }
                };
                ProjectionOutcome::Projected(Ok(source))
            }
            Err(source) => {
                let source = match downcast_responses_alias_error_to_v_1(
                    source,
                    adapters,
                ) {
                    Ok(value) => value,
                    Err(error) => {
                        return ProjectionOutcome::Unsupported {
                            head,
                            error,
                        };
                    }
                };
                ProjectionOutcome::Projected(Err(source))
            }
        }
    }
    /// Execute a caller-supplied Head handler once after successful adaptation.
    pub async fn dispatch_responses_alias_from_v_1<F, Fut>(
        wire: ::serde_json::Value,
        handler: F,
        adapters: &(dyn VersionAdapters + Sync),
    ) -> Result<
        ProjectionOutcome<ResponsesAliasResultV1, ResponsesAliasResultV2>,
