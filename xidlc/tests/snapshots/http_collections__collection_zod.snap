  "http_collections.zod.ts": "// Code generated by xidlc-v0.0.1-snapshot. DO NOT EDIT.\n\n\nimport { z } from \"zod\";\nimport { xjson } from \"xidl-typescript-codec\";\n\n    \n    export const CollectionsSchema = z.object({\n        \n            values: z.array(z.union([z.number(), z.string().regex(/^[+-]?[0-9]+(?![\\s\\S])/).transform(Number)]).pipe(z.number().int())),\n        \n            tags: z.array(z.coerce.string()),\n        \n            names: z.array(z.coerce.string()),\n        \n            labels: z.array(z.coerce.string()).nullish().transform((value) => value ?? undefined)\n        \n    });\n\n    \n    export const SearchSchema = z.object({\n        \n            term: z.coerce.string().nullish().transform((value) => value ?? undefined)\n        \n    });\n\n    \n    export const StreamValuesSchema = z.object({\n        \n            values: z.array(z.union([z.number(), z.string().regex(/^[+-]?[0-9]+(?![\\s\\S])/).transform(Number)]).pipe(z.number().int())).nullish().transform((value) => value ?? undefined)\n        \n    });\n\n    \n    export const NumbersSchema = z.object({\n        \n            count: z.union([z.number(), z.string().regex(/^[+-]?[0-9]+(?![\\s\\S])/).transform(Number)]).pipe(z.number().int()),\n        \n            ratio: z.union([z.number(), z.string().regex(/^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])/).transform(Number)]).pipe(z.number()),\n        \n            units: z.union([z.number(), z.string().regex(/^[+]?[0-9]+(?![\\s\\S])/).transform(Number)]).pipe(z.number().int().nonnegative()),\n        \n            threshold: z.union([z.number(), z.string().regex(/^[+-]?[0-9]+(?![\\s\\S])/).transform(Number)]).pipe(z.number().int()).nullish().transform((value) => value ?? undefined)\n        \n    });\n\n    export namespace transport {\n\n        export const CountSchema = z.union([z.number(), z.string().regex(/^[+-]?[0-9]+(?![\\s\\S])/).transform(Number)]).pipe(z.number().int());\n\n       