            ) -> Result<
                xidl_rust_axum::stream::ReaderWriter<DuplexShapesScalarRequest, String>,
                xidl_rust_axum::Error,
            > {
                let xidl_path = "/scalar".to_string();
                let mut req = self
                    .client
                    .http()
                    .request(
                        xidl_rust_axum::reqwest::Method::GET,
                        self.client.url(&xidl_path),
                    )
                    .build()
                    .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
                req.headers_mut()
                    .insert(
                        xidl_rust_axum::reqwest::header::ACCEPT,
                        xidl_rust_axum::reqwest::header::HeaderValue::from_str(
                                "application/x-ndjson",
                            )
                            .map_err(|err| xidl_rust_axum::Error::new(
                                400,
                                format!("{err:?}"),
                            ))?,
                    );
                let auth_target = &self.client;
                let _ = auth_target;
                let mut ws_url = self.client.ws_url(&xidl_path)?;
                let mut auth_headers = req.headers().clone();
                let mut version_cookies = Vec::new();
                for header in auth_headers
                    .get_all(::xidl_rust_axum::reqwest::header::COOKIE)
                {
                    let header = header
                        .to_str()
                        .map_err(|error| ::xidl_rust_axum::Error::new(
                            400,
                            format!("invalid Cookie header: {error}"),
                        ))?;
                    version_cookies
                        .extend(
