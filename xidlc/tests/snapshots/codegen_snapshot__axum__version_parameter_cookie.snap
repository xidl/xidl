                                .split(';')
                                .map(str::trim)
                                .filter(|cookie| {
                                    !cookie.is_empty()
                                        && cookie
                                            .split_once('=')
                                            .is_none_or(|(name, _)| name.trim() != "api%v")
                                })
                                .map(str::to_string),
                        );
                }
                version_cookies
                    .push("api%v=%E7%89%88%E6%9C%AC%20%2B%2F%25%3B%3D".to_string());
                auth_headers
                    .insert(
                        ::xidl_rust_axum::reqwest::header::COOKIE,
                        ::xidl_rust_axum::reqwest::header::HeaderValue::from_str(
                                &version_cookies.join("; "),
                            )
                            .map_err(|error| ::xidl_rust_axum::Error::new(
                                400,
                                format!("invalid version cookie: {error}"),
                            ))?,
                    );
                return xidl_rust_axum::stream::open_bidi_client_with_headers::<
                    DuplexShapesScalarRequest,
                    String,
                >(&ws_url, auth_headers)
