    export function downcastMessage(version: "v1" | "v2", head: types.v2.Message, stored: StoredValues, adapters: VersionAdapters): VersionedResult<types.v1.Message | types.v2.Message> {
        switch (version) {
            
                case "v1": {
                    
                        const step0 = downcastMessageToV1(head, stored, adapters);
                        if (!step0.ok) return step0;
                    
                    return step0;
                }
            
                case "v2": {
                    
                    return ok(head);
                }
            
        }
    }
