                req.headers_mut()
                    .insert(
                        xidl_rust_axum::reqwest::header::ACCEPT,
                        xidl_rust_axum::reqwest::header::HeaderValue::from_str("")
                            .map_err(|err| xidl_rust_axum::Error::new(
                                400,
                                format!("{err:?}"),
                            ))?,
                    );
                let auth_target = &self.client;
                let _ = auth_target;
                let resp = self
                    .client
                    .http()
                    .execute(req)
                    .await
                    .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
                if resp.status().is_success() {
                    Ok(())
                } else {
                    let status = resp.status();
                    if status.as_u16() == 429 {
                        let headers = resp.headers().clone();
                        let mut value: super::super::errors::Failure = ::core::default::Default::default();
                        value.hint = match headers.get("X-Hint") {
                            Some(header_value) => {
                                let header_str = header_value
                                    .to_str()
                                    .map_err(|err| xidl_rust_axum::Error::new(
                                        400,
                                        format!("{err:?}"),
                                    ))?;
                                xidl_rust_axum::serde_json::from_str(header_str)
                                    .map_err(|err| xidl_rust_axum::Error::new(
                                        400,
                                        format!("{err:?}"),
                                    ))?
                            }
                            None => ::core::default::Default::default(),
                        };
                        return Err(ScopedFailureError::Failure(value));
                    }
                    let body = resp.json::<xidl_rust_axum::ErrorBody>().await.ok();
                    Err(
                        ScopedFailureError::Framework(
                            xidl_rust_axum::Error::from_http_response(status, body),
                        ),
                    )
                }
            }
            #[allow(
                clippy::useless_conversion,
                unused_mut,
                unreachable_code,
                unused_variables
            )]
            pub async fn choice(
                &self,
                payload: super::Choice,
            ) -> Result<super::Choice, xidl_rust_axum::Error> {
                let xidl_path = "/scoped/choice".to_string();
                let mut req = self
                    .client
                    .http()
                    .request(
                        xidl_rust_axum::reqwest::Method::POST,
                        self.client.url(&xidl_path),
                    )
                    .build()
                    .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
                req.headers_mut()
                    .insert(
                        xidl_rust_axum::reqwest::header::ACCEPT,
                        xidl_rust_axum::reqwest::header::HeaderValue::from_str(
                                "application/json",
                            )
                            .map_err(|err| xidl_rust_axum::Error::new(
                                400,
                                format!("{err:?}"),
                            ))?,
                    );
                let auth_target = &self.client;
                let _ = auth_target;
                let body: super::Choice = payload;
                let body = xidl_rust_axum::SerializeFactory::new("application/json")
                    .to_vec(&body)?;
                req.headers_mut()
                    .insert(
                        xidl_rust_axum::reqwest::header::CONTENT_TYPE,
                        xidl_rust_axum::reqwest::header::HeaderValue::from_str(
                                "application/json",
                            )
                            .map_err(|err| xidl_rust_axum::Error::new(
                                400,
                                format!("{err:?}"),
                            ))?,
                    );
                *req.body_mut() = Some(xidl_rust_axum::reqwest::Body::from(body));
                let resp = self
                    .client
                    .http()
                    .execute(req)
                    .await
                    .map_err(|err| xidl_rust_axum::Error::new(500, format!("{err:?}")))?;
                if resp.status().is_success() {
                    let body = resp
                        .bytes()
                        .await
                        .map_err(|err| xidl_rust_axum::Error::new(
                            500,
                            format!("{err:?}"),
                        ))?;
                    let body: super::Choice = xidl_rust_axum::DeserializeFactory::new(
                            "application/json",
                        )
                        .from_slice(&body)?;
                    Ok(body)
                } else {
                    let status = resp.status();
                    let body = resp.json::<xidl_rust_axum::ErrorBody>().await.ok();
                    Err(xidl_rust_axum::Error::from_http_response(status, body))
                }
            }
        }
    }
}
