export class ScopedClient {
    private readonly baseUrl: string;
    private readonly fetchImpl: FetchLike;
    private readonly defaultHeaders: Record<string, string>;
    private readonly auth?: ClientAuth;
    private readonly codecs: Record<string, HttpCodec>;

    constructor(baseUrl: string, options: ClientOptions = {}) {
        this.baseUrl = baseUrl;
        this.fetchImpl = resolveFetch(options.fetch);
        this.defaultHeaders = options.headers ?? {};
        this.auth = options.auth;
        this.codecs = options.codecs ?? {};
    }
    
        async read(): Promise<string> {
            let path = "/scoped";
            const query = new URLSearchParams();
            const headers = new Headers(this.defaultHeaders);
            const cookies: string[] = [];
            applyCookies(headers, cookies);
            applyClientAuth(path, query, headers, this.auth, []);
            const queryString = query.toString();
            if (queryString.length > 0) {
                path = `${path}?${queryString}`;
            }
            const url = joinUrl(this.baseUrl, path);
            headers.set("Accept", "text/plain");
        const resp = await this.fetchImpl(url, { method: "GET", headers });
        if (!resp.ok) {
            await this.throwReadError(resp);
            
        }
        return await decodeResponseBody<string>(resp, "text/plain", this.codecs);
        
    }
    
    
        async throwReadError(resp: Response): Promise<never> {
            const status = resp.status;
            if (status === 409) {
                const bodySchema = z.object({ "detail": ifaceSchemas.models.left.DetailSchema,  });
                const rawBody = await resp.clone().json().catch(() => undefined);
