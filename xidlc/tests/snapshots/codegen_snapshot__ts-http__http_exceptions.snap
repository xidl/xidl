                const decoded = bodySchema.safeParse(deserialize(rawBody, bodySchema));
                if (!decoded.success) throw await parseXidlError(resp);
                const body = decoded.data;
                throw new left$Failure({
                    "detail": body["detail"] as never,
                    });
            }
            if (status === 422) {
                const bodySchema = z.object({ "reason": z.coerce.string(),  });
                const rawBody = await resp.clone().json().catch(() => undefined);
                if (rawBody == null || rawBody["reason"] === undefined) throw await parseXidlError(resp);
                const decoded = bodySchema.safeParse(deserialize(rawBody, bodySchema));
                if (!decoded.success) throw await parseXidlError(resp);
                const body = decoded.data;
                throw new right$Failure({
                    "reason": body["reason"] as never,
