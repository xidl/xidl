#pragma xidlc package versioned_petstore

@version
enum ApiVersions {
    @rename("1.0") v1,
    @rename("2.0") v2,
};

struct Pet {
    string id;
    @added(ApiVersions::v2)
    @optional string note;
    @removed(ApiVersions::v2)
    string color;
};

interface Pets {
    @get(path = "/pets/{id}")
    Pet get(@path string id);

    @added(ApiVersions::v2)
    @get(path = "/pets")
    sequence<Pet> list();

    @removed(ApiVersions::v2)
    @get(path = "/legacy")
    string legacy();
};
