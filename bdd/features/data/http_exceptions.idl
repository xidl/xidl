#pragma xidlc package Demo API
#pragma xidlc version v1

@http(304)
exception NotModified {
    @header("ETag") string etag;
};

@http(status = 412)
exception PreconditionFailed {
    @header(name="ETag") string etag;
    @header("X-Hint") @optional sequence<string> hints;
    @header @rename("Abc") string rename_abc;
    @cookie @rename("session") string session_id;
    @cookie("retry") @optional string retry_token;
    @cookie(name="attempt") @optional sequence<string> attempts;
    @body uint32 code;
    @body @rename("message") string msg;
    @body @optional string detail;
};

@http(404)
exception NotFound {
    @body uint32 code;
    @body string msg;
};

@http(410)
exception EmptyGone {};

@http(418)
exception Reserved {
    @body string type;
    @header("X-Select") string select;
    @cookie("type") string TypeID;
};

struct FileMeta {
    string id;
    string etag;
};

@no_security
interface Files {
    @get(path = "/files/{id}")
    FileMeta get_file(@path string id)
        raises(NotModified, PreconditionFailed, NotFound, EmptyGone, Reserved);
};

module left {
    struct Detail { string message; };
    @http(409) exception Failure { @body Detail detail; };
};
module right {
    @http(422) exception Failure { @body string reason; };
};
@no_security
interface Scoped {
    @get(path = "/scoped")
    string read() raises(left::Failure, ::right::Failure);
};

module collision {
    @http(409) exception FilesClient { @body string reason; };
    @http(502) exception Framework { @body string reason; };
};
@no_security
interface Naming {
    @get(path = "/names/{id}")
    void read(@path string id) raises(collision::FilesClient, collision::Framework);
};
