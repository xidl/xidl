#pragma xidlc package Envelope API
#pragma xidlc version v1

// A same-named type at the operation scope must not capture the union payload.
struct FileMeta { string wrong; };

module representations {
// Representation switching (#296): one route, three media types.
// ContentType is provided by the compiler when an @http union is present.
struct FileDetails { string label; };

struct FileMeta {
    @rename("wire_id") string id;
    string etag;
    @flatten ::representations::FileDetails details;
    @optional string note;
};

@http
union FileResponse switch (ContentType) {
    case ::ContentType::Json: FileMeta meta;
    case ContentType::OctetStream: sequence<octet> raw;
    case Text: string text;
};

};

// Typed error channel (#294): status + headers + body per exception.
@http(304)
exception NotModified {
    @header @rename("ETag") string etag;
};

@http(412)
exception PreconditionFailed {
    @header @rename("ETag") string etag;
    uint32 code;
    string msg;
};

@http(404)
exception NotFound {
    uint32 code;
    string msg;
};

@http(404)
exception HeadMissing {
    @header @rename("X-Error-Code") string code;
};

@no_security
interface EnvelopeApi {
    @get(path = "/file")
    representations::FileResponse get_file(
        @query string key,
        @header @rename("ETag") out string etag,
        @header @rename("X-Tag") out sequence<string> tags,
        @cookie out boolean cached
    ) raises(NotFound);

    @head(path = "/file")
    void head_file(
        @query string key,
        @header @rename("ETag") out string etag,
        @header @rename("X-Size") out uint64 size,
        @cookie out boolean cached
    ) raises(HeadMissing);

    @get(path = "/fresh")
    string get_fresh() raises(NotModified);

    @delete(path = "/file")
    void delete_file(
        @header @rename("If-Match") string if_match
    ) raises(PreconditionFailed);
};
