import "sources/origin.idl";
#include "types.idl"

const origin::HTTPState InitialState = origin::HTTPState::ready;
struct ImportedExports {
    origin::SourceDetail detail;
    origin::SourceAlias alias;
    origin::SourceEvent::Payload payload;
};

module ledger {
    @http(409)
    exception Failure { @body Detail detail; };

    @no_security
    interface Entries {
        typedef Detail View;
        struct Envelope { Entry entry; View detail; };

        @post(path = "/entries/{id}")
        Envelope save(@path string id, @body Envelope value) raises(Failure);
    };
};
