#pragma xidlc package versioned_adapters

@version
enum ApiVersions {
    @rename("1.0") v1,
    @rename("2.0") v2,
};

struct Item {
    string name;
    /** Required since v2: the upcast hook must supply it. */
    @added(ApiVersions::v2) string owner;
    /** Optional since v2: stays absent on the way up. */
    @added(ApiVersions::v2) @optional string note;
    /** Optional until v2: omitted on the way down without a decision. */
    @removed(ApiVersions::v2) @optional string color;
    /** Retired wire name of the reference. */
    @removed(ApiVersions::v2) @rename("ref") string ref_v1;
    /** Replacement wire name since v2: pairs with the retired reference. */
    @added(ApiVersions::v2) @rename("ref") string ref_v2;
};

@http(404)
exception NotFound {
    string id;
};

/** Raised since v2: the error downcast hook's subject. */
@added(ApiVersions::v2)
@http(409)
exception Locked {
    string owner;
};

/** Outcome vocabulary that widens in v2. */
enum State {
    draft,
    @added(ApiVersions::v2) archived,
};

interface Items {
    @get(path = "/items/{id}")
    Item get(@path string id) raises(NotFound, Locked);

    @post(path = "/items")
    State create(@body Item item, @added(ApiVersions::v2) @query string actor);
};
