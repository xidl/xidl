@version enum Versions {
    @rename("2026-01") v1,
    @rename("2026-04") v2,
    @rename("2026-07") v3,
};

struct Address {
    @rename("zip_code") string zip;
    @added(Versions::v3) @optional string zone;
    // Retired inside a container element: older releases still read it from
    // storage per element, so readers resolve identity from the element.
    @removed(Versions::v3) @optional string gate;
};

struct Parcel {
    string id;
    @removed(Versions::v2) @rename("reference") string legacy;
    @added(Versions::v2) @rename("reference") string tracking;
    @added(Versions::v2) string carrier;
    @added(Versions::v2) @optional string note;
    @added(Versions::v3) @optional string inspected;
    @added(Versions::v3) string audit;
    // Head defaults to requiring a signature; older callers never asked for one,
    // so the upcast decision must state the value their version implied.
    @added(Versions::v3) @optional @default(true) boolean signature_required;
    // Retired without a successor: v1 and v2 clients still read it, so storage keeps it.
    @removed(Versions::v3) @optional string handling_note;
    // Renamed at Head: v2 clients still write the earlier wire name, and the
    // generated chain copies it mechanically, with no hook and no storage need.
    @added(Versions::v2) @removed(Versions::v3) @optional string courier_note;
    @added(Versions::v3) @replaces(courier_note) @optional string courier_remark;
    Address address;
    sequence<Address> stops;
    map<string, Address> by_tag;
    Address fixed[2];
};

struct ParcelPatch {
    @optional string note;
    // Retired together with Parcel.handling_note: the patch that removes it on
    // Head must still let v1 and v2 clients persist it through the update flow.
    @removed(Versions::v3) @optional string handling_note;
};

struct Contact {
    @flatten Address address;
    @flatten map<string, string> tags;
};

struct Extra {
    string fixed;
    @flatten any metadata;
    @added(Versions::v3) @optional string future;
};

struct OptionalChange {
    @removed(Versions::v2) @optional string note;
    @added(Versions::v2) @optional string note;
};

struct Node { string name; @optional sequence<Node> children; };

// Inheritance keeps one flattened wire shape per release: a member retired on
// the base stays readable by every release that still declares it, and the
// whole derived conversion is one application decision.
struct Labelled {
    string label;
    @removed(Versions::v3) @optional string tag;
};
struct Signed : Labelled { string signature; };

enum State {
    pending,
    @added(Versions::v2) shipping,
    @added(Versions::v3) delivered,
};

union Choice switch(long) {
    case 0: string text;
    case 1: @added(Versions::v2) long count;
};

@http(404) exception NotFound { string id; };
@added(Versions::v2) @http(409) exception Busy { string reason; };
@added(Versions::v3) @http(429) exception Framework { string reason; };
@added(Versions::v3) @http(403) exception Denied { string reason; };

interface Depot {
    @post(path = "/parcels") State ship(@body Parcel parcel);
    @patch(path = "/parcels/{id}") Parcel update(@path string id, @body ParcelPatch patch) raises(NotFound, Busy, Framework, Denied);
    @get(path = "/parcels/{id}") Parcel get(@path string id) raises(NotFound, Busy, Framework, Denied);
    @post(path = "/contacts") Contact contact(@body Contact contact);
    @post(path = "/extra") Extra extra(@body Extra extra);
    @post(path = "/optional") OptionalChange optional_change(@body OptionalChange value);
    @post(path = "/nodes") Node inspect(@body Node node);
    @post(path = "/states") State state(@body State state);
    @post(path = "/choices") Choice choose(@body Choice choice);
    @post(path = "/receipts") Signed receipt(@body Parcel parcel);
    @post(path = "/blobs") long blob(@body sequence<octet> data);
    @get(path = "/bindings") string bindings(@query @rename("x") string q, @header @rename("x") string h);
    @added(Versions::v3) @get(path = "/head") string head_only();
    // The response header retires in v3: served versions still read it from storage.
    @get(path = "/trace/{id}")
    string trace(@path string id, @removed(Versions::v3) @header out string trace_id) raises(NotFound);
};
