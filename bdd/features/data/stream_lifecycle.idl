#include "stream_lifecycle_types.idl"

interface Ledger {
    @server_stream
    @get(path = "/exports/{job}")
    ExportRow export_rows(@path string job) raises(Conflict, Retired, NotModified);

    @client_stream
    @post(path = "/imports")
    ImportResult import_rows(in ExportRow row) raises(Conflict);
};
