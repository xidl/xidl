interface Addresses {
    @get(path = "/tenants/{tenant}/addresses/{id}")
    Address read(@path string tenant, @path string id) raises(::shipping::Missing, ::shipping::Projection, ::shipping::Forbidden);
    @patch(path = "/tenants/{tenant}/addresses/{id}")
    Address update(@path string tenant, @path string id, @body Change patch) raises(::shipping::Missing, ::shipping::Projection, ::shipping::Forbidden);
};
