// This unrelated local alias must not rebind ::DeliveryReference.
typedef long DeliveryReference;
typedef string Identifier;
enum Country { US, CA };
// Local shadowing must not change the shared coordinate contract.
const long COORDINATE_AXES = 3;
typedef double Coordinates[::BOUND_COMPONENTS / 2], Bounds[::BOUND_COMPONENTS];
typedef Coordinates MapPosition;
struct Marker {};
struct Anchor : Marker {
    @optional string checkpoint;
    @optional Anchor parent;
    @optional sequence<Anchor> previous;
};

@rename_all("camelCase")
struct Identity : Anchor {
    Identifier id;
    string tenant;
    @removed(Versions::v3) ::DeliveryReference delivery_reference;
    @removed(Versions::v3) @optional string delivery_note;
    @added(Versions::v3) @optional @default(true) boolean signature_required;
};

@rename_all("camelCase")
struct Change {
    @optional Anchor parent;
    @removed(Versions::v3) @optional ::DeliveryReference delivery_reference;
    @removed(Versions::v3) @optional string delivery_note;
    @added(Versions::v3) @optional @default(true) boolean signature_required;
};
