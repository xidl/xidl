module Relay {
    struct UserRef { string id; };
    struct Participant : UserRef { string role; };
    enum ReactionKind { LIKE, LOVE };
    union Reaction switch (ReactionKind) { case ReactionKind::LIKE: string like_by; case ReactionKind::LOVE: string love_by; };
    interface Media {
        @post(path = "/r") Reaction react(@body Reaction reaction);
        @get(path = "/p") Participant who();
    };
};
